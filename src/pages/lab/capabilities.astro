---
// DEV-ONLY design lab. Four layout options for "What we do" with pixel icons.
// Redirects in production so it can never be linked or indexed from the live
// site; delete this file once a direction is picked.
// 302, NOT 301 — a permanent redirect gets cached by the browser and makes this
// page unreachable in dev afterwards. See the note in lab/pricing.astro.
if (!import.meta.env.DEV) return Astro.redirect("/", 302);

import Base from "../../layouts/Base.astro";
import PixelIcon from "../../components/ds/PixelIcon.astro";

// Five capabilities. "Generative media & creative" removed per review.
// Order is build -> instrument -> create -> distribute -> automate: you fix the
// story first, instrument it so you can see what moves, create the assets that
// earn attention, distribute them, then systematise the whole loop. This swaps
// Research ahead of Search, since the research IS what search and social
// distribute; the old order asked you to distribute before you had made
// anything. It also ends on the most forward-looking capability.
const caps = [
  { n: "01", icon: "pencil-ruler", title: "Positioning &amp; web&nbsp;design", kicker: "pitch + site",
    body: "Bulletproof your pitch by auditing it against peer-reviewed findings on brand, messaging, design, pricing, trial terms, etc., then pair it with a site built on modern frameworks." },
  { n: "02", icon: "analytics", title: "Tech stack &amp; analytics", kicker: "audit",
    body: "Get the insights you need to make better GTM investment decisions by reviewing your tech stack, tag setup, and analytics pipes to understand gaps and areas of improvement." },
  { n: "03", icon: "newspaper", title: "Research, data &amp; IP creation", kicker: "reports + IP",
    body: "Establish your topical authority with custom industry reports, white papers, and thematic content series that earn press coverage, buyer attention, and sales pipeline." },
  { n: "04", icon: "trending", title: "Search, AI &amp; social growth", kicker: "share of voice",
    body: "Track and improve your share of voice in traditional search, AI citations, and social channels by producing high-quality content rooted in a deep understanding of your ICP." },
  { n: "05", icon: "robot", title: "AI × GTM transformation", kicker: "systems · agents",
    body: "Build repeatable systems for every aspect of your GTM process including brand, creative, organic growth, analytics, sales operations, etc., with custom skills, plugins, and AI agents." },
] as const;

const OPTIONS = [
  { id: "a", name: "Option A — Icon replaces the numeral", note: "Closest to what is live. The icon takes the left rail; the number goes away. Quietest change, and the row stays one line tall on desktop." },
  { id: "b", name: "Option B — Numeral and icon together", note: "Keeps the ledger index and adds the icon beside the title. Most information, and the numerals still let you refer to “03” in a call." },
  { id: "c", name: "Option C — Framed cells", note: "Breaks the bands into a 3+2 grid of figure frames. Most visual weight per capability; loses the single-column ledger reading order." },
  { id: "d", name: "Option D — Rule-separated index", note: "No fill at all. Icon and title share a line, kicker sits right-aligned on the rule, body indents under. Driest and most editorial." },
];
---
<Base title="LAB — capability layouts">
  <div class="lab">
    <header class="lab__head">
      <div class="aol-eyebrow" style="color:var(--copper-600)">dev only · not linked from the site</div>
      <h1 class="aol-display" style="font-size:38px;margin:10px 0 8px">Capability layouts</h1>
      <p class="lab__lede">
        Five capabilities, pixel icons from the HackerNoon Pixel Icon Library (24px grid, same pixel
        logic as Departure Mono). “Generative media &amp; creative” removed. Order runs
        build → instrument → create → distribute → automate.
      </p>
      <nav class="lab__nav">
        {OPTIONS.map((o) => <a class="aol-flink" href={`#opt-${o.id}`}>{o.name.split(" — ")[0]}</a>)}
      </nav>
    </header>

    {OPTIONS.map((o) => (
      <section class="lab__opt" id={`opt-${o.id}`}>
        <div class="lab__opthead">
          <h2 class="lab__optname">{o.name}</h2>
          <p class="lab__optnote">{o.note}</p>
        </div>

        {o.id === "a" && (
          <div class="lg">
            {caps.map((c) => (
              <div class="lg__band">
                <span class="lg__mark"><PixelIcon name={c.icon} size={20} /></span>
                <div><h3 class="lg__title" set:html={c.title} /><span class="lg__kicker">{c.kicker}</span></div>
                <p class="lg__body">{c.body}</p>
              </div>
            ))}
          </div>
        )}

        {o.id === "b" && (
          <div class="lg lg--wide">
            {caps.map((c) => (
              <div class="lg__band">
                <span class="lg__n">{c.n}</span>
                <div class="lg__headcell">
                  <span class="lg__inlineicon"><PixelIcon name={c.icon} size={18} /></span>
                  <div><h3 class="lg__title" set:html={c.title} /><span class="lg__kicker">{c.kicker}</span></div>
                </div>
                <p class="lg__body">{c.body}</p>
              </div>
            ))}
          </div>
        )}

        {o.id === "c" && (
          <div class="cells">
            {caps.map((c) => (
              <div class="cell">
                <span class="cell__crop cell__crop--tl"></span><span class="cell__crop cell__crop--br"></span>
                <div class="cell__top">
                  <span class="cell__icon"><PixelIcon name={c.icon} size={22} /></span>
                  <span class="cell__fig">FIG. {c.n}</span>
                </div>
                <h3 class="cell__title" set:html={c.title} />
                <span class="lg__kicker">{c.kicker}</span>
                <p class="cell__body">{c.body}</p>
              </div>
            ))}
          </div>
        )}

        {o.id === "d" && (
          <div class="idx">
            {caps.map((c) => (
              <div class="idx__row">
                <div class="idx__line">
                  <span class="idx__icon"><PixelIcon name={c.icon} size={18} /></span>
                  <h3 class="idx__title" set:html={c.title} />
                  <span class="idx__rule"></span>
                  <span class="idx__kicker">{c.kicker}</span>
                </div>
                <p class="idx__body">{c.body}</p>
              </div>
            ))}
          </div>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .lab { max-width: var(--container-width); margin: 0 auto; padding: var(--space-12) var(--gutter) var(--space-24); }
  .lab__head { margin-bottom: var(--space-12); }
  .lab__lede { font-family: var(--font-serif); font-size: 17px; line-height: 1.6; color: var(--ink-600); max-width: 62ch; margin: 0 0 16px; }
  .lab__nav { display: flex; gap: 18px; flex-wrap: wrap; }
  .lab__opt { margin-bottom: var(--space-20); scroll-margin-top: 24px; }
  .lab__opthead { margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px dotted var(--ink-300); }
  .lab__optname { font-family: var(--font-display); font-weight: 400; font-size: 26px; margin: 0 0 6px; color: var(--ink-900); }
  .lab__optnote { font-family: var(--font-mono); font-size: 12px; line-height: 1.6; color: var(--ink-600); margin: 0; max-width: 78ch; }

  /* ---- shared band shell (Options A + B) ---- */
  .lg { border-top: 1.5px solid var(--ink-900); border-bottom: 1.5px solid var(--ink-900); }
  .lg__band { display: grid; grid-template-columns: 44px minmax(0,0.9fr) minmax(0,1.25fr); gap: 0 24px; align-items: start; padding: 14px 18px 15px; }
  .lg--wide .lg__band { grid-template-columns: 44px minmax(0,0.95fr) minmax(0,1.2fr); }
  .lg__band + .lg__band { border-top: 1px solid var(--border-hairline); }
  .lg__band:nth-child(odd) { background: var(--surface-warm); }
  .lg__band:nth-child(odd) + .lg__band { border-top-color: var(--border-warm); }
  .lg__mark { color: var(--accent-warm); padding-top: 3px; display: block; }
  .lg__band:nth-child(even) .lg__mark { color: var(--signal); }
  .lg__n { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-tick); color: var(--accent-warm); font-variant-numeric: tabular-nums; padding-top: 7px; }
  .lg__band:nth-child(even) .lg__n { color: var(--signal); }
  .lg__headcell { display: flex; gap: 10px; align-items: flex-start; }
  .lg__inlineicon { color: var(--accent-warm); padding-top: 4px; flex: none; }
  .lg__band:nth-child(even) .lg__inlineicon { color: var(--signal); }
  .lg__title { font-family: var(--font-display); font-weight: 400; font-size: var(--text-xl); line-height: 1.08; color: var(--text-strong); margin: 0; overflow-wrap: break-word; }
  .lg__kicker { display: block; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-faint); margin-top: 6px; }
  .lg__body { margin: 2px 0 0; font-family: var(--font-serif); font-size: var(--text-sm); line-height: 1.5; color: var(--text-on-warm-muted); text-wrap: pretty; }
  .lg__band:nth-child(even) .lg__body { color: var(--text-muted); }

  /* ---- Option C: framed cells ---- */
  .cells { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; }
  .cell { position: relative; border: 1px solid var(--ink-900); border-radius: var(--radius-md); background: var(--surface-warm); padding: 20px 22px 22px; }
  .cell:nth-child(even) { background: var(--paper-pure); }
  .cell__crop { position: absolute; width: 7px; height: 7px; border-color: var(--ink-900); border-style: solid; border-width: 0; }
  .cell__crop--tl { top: 6px; left: 6px; border-top-width: 1px; border-left-width: 1px; }
  .cell__crop--br { bottom: 6px; right: 6px; border-bottom-width: 1px; border-right-width: 1px; }
  .cell__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .cell__icon { color: var(--accent-warm); display: block; }
  .cell:nth-child(even) .cell__icon { color: var(--signal); }
  .cell__fig { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-tick); color: var(--text-faint); }
  .cell__title { font-family: var(--font-display); font-weight: 400; font-size: 23px; line-height: 1.1; margin: 0 0 2px; color: var(--text-strong); }
  .cell__body { margin: 10px 0 0; font-family: var(--font-serif); font-size: 13.5px; line-height: 1.5; color: var(--text-on-warm-muted); text-wrap: pretty; }
  .cell:nth-child(even) .cell__body { color: var(--text-muted); }

  /* ---- Option D: rule-separated index ---- */
  .idx { border-top: 1.5px solid var(--ink-900); }
  .idx__row { padding: 18px 2px 20px; border-bottom: 1px solid var(--border-hairline); }
  .idx__row:last-child { border-bottom: 1.5px solid var(--ink-900); }
  .idx__line { display: flex; align-items: center; gap: 12px; }
  .idx__icon { color: var(--signal); flex: none; display: block; }
  .idx__title { font-family: var(--font-display); font-weight: 400; font-size: 26px; line-height: 1; margin: 0; color: var(--text-strong); white-space: nowrap; }
  .idx__rule { flex: 1; height: 3px; background-image: radial-gradient(var(--ink-300) 0.9px, transparent 1.1px); background-size: 6px 3px; background-repeat: repeat-x; background-position: center; }
  .idx__kicker { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-faint); flex: none; }
  .idx__body { margin: 10px 0 0 30px; font-family: var(--font-serif); font-size: var(--text-sm); line-height: 1.55; color: var(--text-muted); max-width: 82ch; text-wrap: pretty; }

  @media (max-width: 900px) { .cells { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (max-width: 820px) {
    .lg__band, .lg--wide .lg__band { grid-template-columns: 40px minmax(0,1fr); gap: 0 12px; }
    .lg__body { grid-column: 2; margin-top: 8px; }
    .idx__title { white-space: normal; }
    .idx__rule { display: none; }
  }
  @media (max-width: 560px) { .cells { grid-template-columns: minmax(0,1fr); } }
</style>
