---
/**
 * Render source for a weekly newsletter issue cover (the post's `heroImage`,
 * which also serves as its OG card).
 *
 * A /lab/ route for the same reason the OG cards are: astro.config.mjs's
 * sitemap filter already excludes /lab/, and authoring the cover as a real page
 * means it uses the site's own tokens and webfonts rather than a lookalike
 * rebuilt in SVG. It is a rendering jig, not a page.
 *
 * ── Why it looks like this ──
 *
 * GROUND is blue-050 and the portraits are dithered blue-050/blue-700, so the
 * cast sits ON the cover rather than in three pasted rectangles. That is the
 * same duotone `ditherPreset.HERO` bakes into every other post hero, which is
 * what keeps an illustrated cover in the same family as the photographic ones.
 *
 * COPPER marks the issue line and nothing else. The `ai-newsletter` category
 * already carries the copper badge everywhere else on the site, so the cover
 * takes the same mark — and copper stays a label, never an action, and is never
 * paired with blue as an equal accent.
 *
 * TYPE is crisp, not dithered. The dither is a texture treatment for
 * photographs; run over 100px display type it eats the letterforms. The
 * portraits carry the texture and the words stay readable at thumbnail size,
 * which is the size this is actually seen at in a feed.
 *
 * The portraits are read off disk and inlined as data URIs rather than served
 * from public/. They exist only to be composited into this one cover — putting
 * them in public/ would publish three loose files to the site to no purpose.
 * Regenerate them with: npx tsx scripts/gen-newsletter-cast.mts
 *
 * To re-render:  node scripts/render-newsletter-cover.mjs
 */
import fs from "node:fs";
import path from "node:path";
import "../../styles/main.css";

const CAST_DIR = path.join(process.cwd(), ".scratch", "newsletter", "cast");

const dataUri = (file: string) =>
  `data:image/png;base64,${fs.readFileSync(path.join(CAST_DIR, file)).toString("base64")}`;

/**
 * The three columnists, in the order they run in the issue.
 *
 * `zoom` normalises head size across the three portraits. PixelLab framed Nova
 * further out than the other two — arms in frame rather than a bust — and three
 * heads at three different scales reads as a mistake on a cover where they sit
 * in a row. Correcting it in CSS costs nothing; regenerating the portrait would
 * have cost a metered API call for the same result.
 */
const CAST = [
  {
    file: "vex-halloran.png",
    name: "Vex Halloran",
    beat: "Frontier Labs & Big Tech",
    line: "Two chiefs gone in seventy-two hours.",
    zoom: 1,
  },
  {
    file: "cass.png",
    name: "Cass",
    beat: "Policy, Safety & Power",
    line: "A classifier now holds the keys.",
    zoom: 1,
  },
  {
    file: "nova-reyes.png",
    name: "Nova Reyes",
    beat: "Startups, Funding & Money",
    line: "Two billion, and the same three people.",
    zoom: 1.16,
  },
];

const ISSUE = "Aug 10–16, 2026";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Cover — The Weekly Overfit</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="cv">
      <div class="cv__card">
        {/* Centred, because the index page crops this cover to 4:3 for its
            264px thumbnail and a centre crop eats the outer eighth on each
            side. A left-aligned masthead loses its first word there. Centred,
            the one thing that has to survive at thumbnail size does. */}
        <header class="cv__top">
          <span class="cv__brand">&#123;ignore all previous instructions&#125;</span>
          <h1 class="cv__masthead">The Weekly Overfit</h1>
          <span class="cv__issue"><i class="cv__dot"></i>{ISSUE}<i class="cv__dot"></i></span>
        </header>

        <span class="cv__rule"></span>

        <ul class="cv__cast">
          {
            CAST.map((member) => (
              <li class="cv__member">
                <span class="cv__frame">
                  <img
                    src={dataUri(member.file)}
                    alt=""
                    width="256"
                    height="256"
                    style={`transform: scale(${member.zoom})`}
                  />
                </span>
                <p class="cv__name">{member.name}</p>
                <p class="cv__beat">{member.beat}</p>
                <p class="cv__line">{member.line}</p>
              </li>
            ))
          }
        </ul>

        <footer class="cv__foot">
          <span class="cv__rule"></span>
          {/* VJ's own list description, verbatim — the promise a reader
              subscribes to should be the same sentence wherever they meet it. */}
          <p class="cv__blurb">
            A weekly newsletter about AI news, written by AI agents, and reluctantly edited by a
            tired human-in-the-loop.
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  /* Fixed pixel values throughout, not tokens — this is a 1600x900 canvas, not a
     responsive page. The COLOURS still come from tokens so the cover cannot
     drift from the palette. */
  :global(body) { margin: 0; }
  /* The dev toolbar injects into every page and lands inside the captured
     frame. This is only ever rendered from `npm run dev`. */
  :global(astro-dev-toolbar) { display: none !important; }

  .cv {
    width: 1600px;
    height: 900px;
    box-sizing: border-box;
    padding: 40px;
    background-color: var(--paper);
    display: flex;
  }

  /* House card construction — full-ink border, hard offset shadow — on the
     blue tint the dithered portraits are thresholded to, so the cast reads as
     printed on the cover rather than pasted onto it. */
  .cv__card {
    flex: 1;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: var(--blue-050);
    border: 1.5px solid var(--ink-900);
    border-radius: 20px;
    box-shadow: 12px 12px 0 0 var(--ink-900);
    padding: 44px 56px 40px;
  }

  .cv__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cv__brand {
    font-family: var(--font-mono);
    font-size: 24px;
    letter-spacing: 0.02em;
    color: var(--blue-500);
  }
  .cv__issue {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 18px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper-700);
  }
  .cv__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--copper-600); }

  /* Instrument Serif has one weight. Its contrast is what reads as bold here,
     so nothing asks for a heavier face that does not exist. */
  .cv__masthead {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: 112px;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
    margin: 8px 0 12px;
  }

  /* Clears the descenders and the copper dots of the issue line above it —
     at 18px mono the line's optical bottom is lower than its box. */
  .cv__rule { display: block; height: 1.5px; background: var(--ink-900); margin-top: 18px; }

  /* `margin: auto 0` on the cast row: the masthead is fixed at the top and the
     blurb is floored, so auto margins split the leftover height evenly above
     and below the three portraits instead of letting all the slack pool under
     them. */
  .cv__cast {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px;
    list-style: none;
    margin: auto 0;
    padding: 0;
  }

  .cv__member { display: flex; flex-direction: column; align-items: center; text-align: center; }

  /* overflow:hidden is what makes `zoom` a crop rather than an overflow — the
     portrait scales up inside a fixed 256px window. */
  .cv__frame {
    display: block;
    width: 256px;
    height: 256px;
    overflow: hidden;
    border: 1.5px solid var(--ink-900);
    border-radius: 14px;
    background: var(--blue-050);
  }
  .cv__frame img {
    display: block;
    width: 256px;
    height: 256px;
    /* The source is a 1-bit dither. Smooth scaling averages neighbouring cells
       into greys the palette does not contain, so the cells stay hard. */
    image-rendering: pixelated;
  }

  .cv__name {
    font-family: var(--font-mono);
    font-size: 25px;
    letter-spacing: 0.01em;
    color: var(--ink-900);
    margin: 20px 0 0;
  }
  .cv__beat {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
    margin: 7px 0 0;
  }
  /* The coverline. Serif, because it is the only line on the cover that is
     writing rather than labelling. */
  .cv__line {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--blue-700);
    margin: 14px 0 0;
  }

  .cv__foot { margin-top: auto; }
  .cv__foot .cv__rule { background: var(--blue-200); margin-bottom: 18px; }
  .cv__blurb {
    font-family: var(--font-mono);
    font-size: 18px;
    letter-spacing: 0.02em;
    color: var(--ink-600);
    margin: 0;
    text-align: center;
  }
</style>
