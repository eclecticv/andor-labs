---
/**
 * Rank My AdTech — the tool's landing page.
 *
 * Copy left, form right. ONE field: the company URL.
 *
 * No email. Entry is frictionless and anyone can submit anyone, which is the
 * point of a public board — at the cost of the lead capture this tool was
 * originally built around. The API still accepts an address and still syncs it
 * to Loops when present, so that capture can return on the RESULT step without
 * putting a second field in front of a first-time visitor.
 *
 * The full board lives at /tools/rank-my-adtech/leaderboard/. This page carries
 * a short preview so a first-time visitor can see the thing is alive without
 * paying for the whole table in vertical space.
 *
 * A run takes 60-90 seconds, because three models each write several sentences
 * of argument before a fourth writes the verdict. The progress line is a pacing
 * device rather than real telemetry (same device as Scout) — but here it earns
 * its keep twice over, because a jury that deliberates for a minute is the
 * premise rather than an apology for it.
 *
 * Results are rendered by cloning templates and setting textContent, NEVER
 * innerHTML: every string came off a third party's homepage by way of a
 * language model.
 */
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/sections/SiteHeader.astro";
import SiteFooter from "../../components/sections/SiteFooter.astro";
import SiteMotion from "../../components/SiteMotion.astro";
import Button from "../../components/ds/Button.astro";
import Input from "../../components/ds/Input.astro";
import PixelIcon from "../../components/ds/PixelIcon.astro";
import DitherLine from "../../components/ds/DitherLine.astro";
import RankTable from "../../components/ds/RankTable.astro";
import { getEntries, DIMENSIONS, GRADER, graderLoadingMessages } from "../../lib/rankings";

const all = await getEntries();
const preview = all.slice(0, 5);
const ranked = all.length;

/**
 * Pacing lines. Deliberately name the grader — that IS the product.
 *
 * Generated rather than typed. Typed once, these went on announcing a lab that
 * was no longer grading while the profile pages named the current one. Naming
 * the grader is the whole point of these lines, so naming it wrongly is worse
 * than not naming it at all.
 */
const STEPS = [
  "Reading the site…",
  "Working out what you are…",
  ...graderLoadingMessages(),
  "Putting a grade on it…",
];

const HOW = [
  { icon: "newspaper", title: "We read the site",
    body: "Up to six pages. The about and press pages, not just the homepage." },
  { icon: "vote-yeah", title: `${GRADER.lab} ${GRADER.name} grades it`,
    body: "One model, temperature 0, against a rubric published in full below." },
  { icon: "shapes", title: "The case against, first",
    body: "Three reasons you are weaker than you look, written before any score exists. Marketing language does not survive that order." },
  { icon: "trophy-solid", title: "Five grades and a verdict",
    body: "Then it goes on the public board, ranked against its own corner of adtech." },
];

const title = "Rank My AdTech — private adtech startups, graded on five dimensions";
const description =
  "One model grades your adtech company 1-5 on five dimensions — originality, defensibility, traction, execution, durability — from your own website, and writes the case against you before it scores anything. Free, and it goes on a public board.";
---

<Base
  title={title}
  description={description}
  ogImage="/og-rank-my-adtech.png"
  ogImageWidth={2400}
  ogImageHeight={1200}
  ogImageAlt="Rank My AdTech — a free And/or Labs tool that grades your adtech company 1-5 on five dimensions and publishes the verdict to a public leaderboard."
>
  <SiteHeader />
  <main>
    {/* ── Hero: copy left, form right ────────────────────────────────────── */}
    <section class="aol-rma__hero">
      <div class="aol-rma__inner aol-rma__split">
        <div class="aol-rma__copy">
          <p class="aol-rma__eyebrow">
            <PixelIcon name="vote-yeah" size={12} /> Free tool ·{" "}
            {ranked > 0 ? `${ranked} ranked` : "fresh board"}
          </p>
          <h1 class="aol-rma__h1 aol-rma__h1--display">Rank My AdTech.</h1>
          <p class="aol-rma__lede">
            One model reads your site, writes down three reasons you are weaker than
            you look, and only then grades you 1&ndash;5 on five dimensions. You get the
            grade, the reasoning, and an opinion you didn't ask for.
          </p>
          <p class="aol-rma__trust">
            <PixelIcon name="handshake" size={12} /> We sell go-to-market work and this
            grades none of it. Nothing here is a pitch — the case against your company
            is published next to its grade.
          </p>
        </div>

        <div class="aol-rma__formcard">
          <form id="rank-form" novalidate>
            <label class="aol-rma__field">
              <span class="aol-rma__label">Company domain</span>
              <Input type="text" name="url" id="rank-url" placeholder="company.com"
                autocomplete="url" inputmode="url" autocapitalize="none"
                autocorrect="off" spellcheck="false"
                aria-describedby="rank-status" required />
            </label>
            <p class="aol-rma__hint">Any private adtech company. Yours or somebody else's.</p>
            <Button type="submit" variant="primary" size="lg" fullWidth id="rank-submit" arrow>
              Rank it
            </Button>

            {/* The stepper is the live region — during a 70-90s run these seven
                lines are the only signal, and they must reach screen readers. */}
            <div class="aol-rma__step" id="rank-step" data-state="idle"
              data-steps={JSON.stringify(STEPS)} role="status" aria-live="polite">
              <span class="aol-rma__step-n" id="rank-step-n">00/07</span>
              <span class="aol-rma__step-text" id="rank-step-text">Takes about a minute. The grader is thorough.</span>
            </div>

            <p class="aol-rma__notice">
              Every ranking goes on the public board, under the company's own name.
              No takebacks — though one email to{" "}
              <a href="mailto:hello@andorlabs.ca?subject=Rank%20My%20AdTech%20removal">hello@andorlabs.ca</a>{" "}
              takes a row down.
            </p>
            <noscript>
              <p class="aol-rma__notice">
                This one needs JavaScript — the grader is called from your browser.
                The board below works either way.
              </p>
            </noscript>
          </form>
          <p class="aol-rma__status" id="rank-status" role="alert"></p>
        </div>
      </div>
    </section>

    {/* ── Result, injected client-side ───────────────────────────────────── */}
    <section class="aol-rma__result-slot" id="rank-result" hidden></section>

    {/* ── Board preview — the proof, before the methodology. A skeptical
        visitor needs "someone else already did this" more than they need the
        mechanism; the old order buried the first row ~1,850px down. ────────── */}
    <section class="aol-rma__board">
      <div class="aol-rma__inner">
        <div class="aol-rma__board-head">
          <h2 class="aol-rma__h2">Top of the board.</h2>
          <a class="aol-rma__board-link" href="/tools/rank-my-adtech/leaderboard/">
            The full leaderboard <span aria-hidden="true">→</span>
          </a>
        </div>
        <RankTable entries={preview} caption={`Top ${preview.length} of ${ranked}`} />

        <p class="aol-rma__disclosure">
          <PixelIcon name="question-circle" size={12} /> Graded by a language model reading
          public pages. An opinion with its reasoning attached, not research. Want a row gone?
          Email{" "}<a href="mailto:hello@andorlabs.ca?subject=Rank%20My%20AdTech%20removal">hello@andorlabs.ca</a>{" "}and it goes.
        </p>
      </div>
    </section>

    {/* ── How it works: one row, not one screen ──────────────────────────── */}
    <section class="aol-rma__axes">
      <div class="aol-rma__inner">
        <h2 class="aol-rma__h2">How it works.</h2>
        <ol class="aol-rma__how">
          {
            HOW.map((s, i) => (
              <li class="aol-rma__how-step">
                <span class="aol-rma__how-n">{String(i + 1).padStart(2, "0")}</span>
                <span class="aol-rma__how-icon"><PixelIcon name={s.icon as any} size={24} /></span>
                <span class="aol-rma__how-title">{s.title}</span>
                <span class="aol-rma__how-body">{s.body}</span>
              </li>
            ))
          }
        </ol>

        <DitherLine />

        <h2 class="aol-rma__h2">The five dimensions.</h2>
        <ul class="aol-rma__axis-row">
          {
            DIMENSIONS.map((d) => (
              <li class="aol-rma__axis-cell">
                <span class="aol-rma__axis-label">
                  <PixelIcon name={d.icon as any} size={12} />
                  {d.label}<em>1–5</em>
                </span>
                <span class="aol-rma__axis-q">{d.question}</span>
              </li>
            ))
          }
        </ul>

        <p class="aol-rma__note">
          The grade is the mean of the five, to one decimal. Letters sit on top: A from
          4.5, B from 3.5, C from 2.5, D from 1.5.
          {" "}Graded by {GRADER.lab} {GRADER.name} — {GRADER.spec}
        </p>
      </div>
    </section>
  </main>

  {/* Result template — cloned and filled with textContent, never innerHTML. */}
  <template id="rank-result-tpl">
    <div class="aol-rma__inner">
      <article class="aol-rma__card">
        <header class="aol-rma__card-head">
          <img class="aol-rma__card-logo" alt="" width="48" height="48" data-logo hidden />
          <div>
            <h2 class="aol-rma__card-name" data-name></h2>
            <p class="aol-rma__card-one-liner" data-one-liner></p>
          </div>
          <div class="aol-rma__card-score">
            <span class="aol-rma__card-total" data-total></span>
            <span class="aol-rma__card-out">/5</span>
          </div>
        </header>
        <p class="aol-rma__card-meta"><span data-cohort></span> <span data-provisional></span></p>
        <p class="aol-rma__card-verdict" data-summary></p>
        <p class="aol-rma__card-split" data-against></p>
        <p class="aol-rma__card-link"><a data-permalink href="#">See the full grade →</a></p>
      </article>
    </div>
  </template>

  {/* The designed failure. Same card frame so it reads as part of the tool. */}
  <template id="rank-fail-tpl">
    <div class="aol-rma__inner">
      <article class="aol-rma__card aol-rma__card--fail">
        <p class="aol-rma__fail-mark"><PixelIcon name="hockey-mask" size={36} /></p>
        <h2 class="aol-rma__card-name" data-headline></h2>
        <p class="aol-rma__card-verdict" data-detail></p>
        <p class="aol-rma__card-link">Nothing was published. Try again in a minute.</p>
      </article>
    </div>
  </template>

  <SiteFooter />
  <SiteMotion />
</Base>

<script>
  const form = document.getElementById("rank-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("rank-status");
  const resultEl = document.getElementById("rank-result");
  const submit = document.getElementById("rank-submit") as HTMLButtonElement | null;
  const stepEl = document.getElementById("rank-step");
  const stepText = document.getElementById("rank-step-text");
  const stepN = document.getElementById("rank-step-n");
  const cardTpl = document.getElementById("rank-result-tpl") as HTMLTemplateElement | null;
  const failTpl = document.getElementById("rank-fail-tpl") as HTMLTemplateElement | null;

  if (form && statusEl && resultEl && stepEl && stepText && stepN && cardTpl && failTpl) {
    const STEPS: string[] = JSON.parse(stepEl.dataset.steps ?? "[]");
    const IDLE = "Takes about a minute. The grader is thorough.";
    const input = document.getElementById("rank-url") as HTMLInputElement | null;
    // Cheap shape gate — "asdf" would otherwise cost the visitor 90 seconds
    // and cost us three model calls before the server says the same thing.
    const DOMAIN = /^(https?:\/\/)?([a-z0-9-]+\.)+[a-z]{2,}([/?#].*)?$/i;
    let timer: number | undefined;
    let running = false;

    const say = (text: string) => { statusEl.textContent = text; };
    const flag = (bad: boolean) => {
      if (input) input.setAttribute("aria-invalid", bad ? "true" : "false");
    };
    // Swap only the button's text node — textContent would take the arrow with it.
    const setLabel = (text: string) => {
      if (!submit) return;
      for (const n of Array.from(submit.childNodes)) {
        if (n.nodeType === Node.TEXT_NODE && n.textContent?.trim()) { n.textContent = text; return; }
      }
    };

    /**
     * Pacing, not telemetry — there is one request and one response.
     *
     * A run is 60-90s over seven lines, so ~11s each lands the last one around
     * when the verdict does. It HOLDS on the final line rather than completing:
     * completion is the result arriving, and claiming it early is a lie the
     * reader can see through. (Same reasoning as Scout's stepper.)
     */
    const runSteps = () => {
      let i = 0;
      const paint = () => {
        stepEl.dataset.state = "busy";
        stepEl.style.setProperty("--step-i", String(i + 1));
        stepText.textContent = STEPS[i] ?? IDLE;
        stepN.textContent = `${String(i + 1).padStart(2, "0")}/${String(STEPS.length).padStart(2, "0")}`;
      };
      paint();
      timer = window.setInterval(() => {
        if (i >= STEPS.length - 1) return;
        i += 1;
        paint();
      }, 11_000);
    };

    const stopSteps = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
      stepEl.dataset.state = "idle";
      stepEl.style.setProperty("--step-i", "0");
      stepText.textContent = IDLE;
      stepN.textContent = `00/${String(STEPS.length).padStart(2, "0")}`;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      // Re-entry guard instead of disabling the button — disabling the focused
      // element silently drops keyboard focus to <body> for the whole run.
      if (running) return;
      const url = input?.value.trim() ?? "";
      if (!url) { flag(true); say("Give us a company domain."); return; }
      if (!DOMAIN.test(url)) { flag(true); say("That doesn't look like a domain. Try acme.com."); return; }
      flag(false);

      running = true;
      form.setAttribute("aria-busy", "true");
      setLabel("Ranking…");
      resultEl.hidden = true;
      say("");
      runSteps();

      try {
        const res = await fetch("/api/rank-my-adtech", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ domain: url }),
        });
        const data = await res.json();

        if (data?.status === "failed") { renderFail(data); return; }
        if (!res.ok) { say(data?.error ?? "That did not work. Try again shortly."); return; }
        if (data.status === "not-adtech") {
          // The designed failure frame, not a one-line mono squint — this is
          // the most common non-success outcome and model prose is reading
          // text, not a label.
          renderFail({ headline: "Not adtech, says the grader.", detail: data.verdict });
          return;
        }
        if (data.status === "already-ranked") {
          say("Already ranked — taking you to the verdict.");
          window.location.href = `/tools/rank-my-adtech/${data.slug}/`;
          return;
        }
        render(data);
      } catch {
        say("The grader is unreachable. Try again shortly.");
      } finally {
        stopSteps();
        running = false;
        form.removeAttribute("aria-busy");
        setLabel("Rank it");
      }
    });

    const show = (node: DocumentFragment) => {
      resultEl!.textContent = "";
      resultEl!.appendChild(node);
      resultEl!.hidden = false;
      // The CSS reduced-motion guard cannot reach a JS-initiated scroll.
      const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      resultEl!.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "start" });
    };

    function renderFail(d: any) {
      const node = failTpl!.content.cloneNode(true) as DocumentFragment;
      const h = node.querySelector("[data-headline]");
      const p = node.querySelector("[data-detail]");
      if (h) h.textContent = d.headline ?? "Something went wrong.";
      if (p) p.textContent = d.detail ?? "";
      show(node);
    }

    /** textContent only — every field here is untrusted model output. */
    function render(d: any) {
      const node = cardTpl!.content.cloneNode(true) as DocumentFragment;
      const set = (sel: string, value: string) => {
        const el = node.querySelector(`[data-${sel}]`);
        if (el) el.textContent = value ?? "";
      };
      set("name", d.name);
      set("one-liner", d.oneLiner);
      set("total", `${d.grade} ${d.letter}`);
      // The cohort, not the raw band. "emerging sell-side" is what the rank on
      // the company page is expressed in, so the card has to speak the same way
      // or the two pages read as two different measurements.
      set("cohort", [d.cohort, d.categoryLabel].filter(Boolean).join(" · "));
      set("provisional", d.provisional ? "· provisional evidence" : "");
      set("summary", d.summary);
      /* The first line of the case against, on the card.
         Under the panel this slot carried the disagreement spread, which was
         the most interesting thing three models could produce. One grader
         produces no disagreement, and the honest equivalent is the strongest
         thing it wrote against the company — which it wrote before it had
         scored anything. */
      set("against", d.caseAgainst?.[0] ?? "");

      const logo = node.querySelector("[data-logo]") as HTMLImageElement | null;
      if (logo && d.logo) { logo.src = d.logo; logo.hidden = false; }

      const permalink = node.querySelector("[data-permalink]") as HTMLAnchorElement | null;
      if (permalink) permalink.href = `/tools/rank-my-adtech/${d.slug}/`;

      show(node);
    }
  }
</script>
