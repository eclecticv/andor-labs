---
/**
 * /tools — the index of free tools.
 *
 * Added when the second tool shipped. The header's own rule is that a section
 * does not get top-level billing "until there are a few"; two tools plus the
 * discovery leaderboard clears that bar, and without an index the newer tool
 * would only be reachable from a link somebody already knows about.
 *
 * ── Empty as of 2026-08-21 ──
 * Subreddit Scout was retired in August and Rank My AdTech went back to WIP, so
 * the list is now zero and the header rule points the other way: /tools/ is out
 * of the nav and out of the sitemap until something ships here again.
 *
 * The page still resolves, because people have the link. An empty `<ul>` under
 * "things you can use" would read as a broken page rather than an empty shelf,
 * so there is a stated empty state instead. Put an entry back in TOOLS and the
 * list renders exactly as before; restoring the nav is a separate one-line
 * change in SiteHeader and SiteFooter.
 */
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/sections/SiteHeader.astro";
import SiteFooter from "../../components/sections/SiteFooter.astro";
import SiteMotion from "../../components/SiteMotion.astro";
import PixelIcon from "../../components/ds/PixelIcon.astro";
import DitherLine from "../../components/ds/DitherLine.astro";

const TOOLS: {
  name: string;
  href: string;
  icon: string;
  blurb: string;
  meta: string;
}[] = [];

const title = "Free tools — And/or Labs";
const description = "Free GTM tools from And/or Labs.";
---

<Base title={title} description={description}>
  <SiteHeader />
  <main>
    <section class="aol-tools">
      <div class="aol-rma__inner">
        <p class="aol-eyebrow aol-rma__eyebrow"><PixelIcon name="bolt" size={12} /> Free tools</p>
        <h1 class="aol-rma__h1">Things you can use without talking to us.</h1>
        <p class="aol-rma__lede">
          We build these to think out loud. They are free, they need no account, and none of
          them ends in a sales call unless you want one.
        </p>

        <DitherLine />

        {TOOLS.length === 0 ? (
          <p class="aol-rma__lede">Nothing here at the moment — the last one went back on the workbench. Check again soon.</p>
        ) : null}

        <ul class="aol-tools__list">
          {
            TOOLS.map((tool) => (
              <li class="aol-tools__item">
                <a class="aol-tools__link" href={tool.href}>
                  <span class="aol-tools__icon">
                    <PixelIcon name={tool.icon as any} size={36} />
                  </span>
                  <span class="aol-tools__body">
                    <span class="aol-tools__name">{tool.name}</span>
                    <span class="aol-tools__blurb">{tool.blurb}</span>
                    <span class="aol-tools__meta">{tool.meta}</span>
                  </span>
                  <span class="aol-tools__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter />
  <SiteMotion />
</Base>
