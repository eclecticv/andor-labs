---
/**
 * The full board — /tools/rank-my-adtech/leaderboard/
 *
 * A static sibling of [slug].astro. Astro resolves static routes before dynamic
 * ones, so this wins over a company whose slug happened to be "leaderboard";
 * the API also refuses that slug outright rather than relying on that.
 *
 * ── Tabs are bands, sections are sides ──
 * Which is the first of the two ranks made structural. "3rd in emerging
 * sell-side" is literally a position in one section of one tab, so a reader who
 * can see the shape of the board can see where the number came from without
 * being told. The second rank — position within a subcategory — lives on the
 * company's own page, where there is room to say which subcategory.
 *
 * The tabs are radio inputs, not JavaScript. Every band stays in the HTML and
 * stays crawlable, the whole thing works with scripting off, and a named radio
 * group is natively arrow-key navigable — which is the interaction a tablist is
 * meant to have. The inputs sit before the panels because CSS can only select
 * forward.
 */
import Base from "../../../layouts/Base.astro";
import SiteHeader from "../../../components/sections/SiteHeader.astro";
import SiteFooter from "../../../components/sections/SiteFooter.astro";
import SiteMotion from "../../../components/SiteMotion.astro";
import PixelIcon from "../../../components/ds/PixelIcon.astro";
import RankBoard from "../../../components/ds/RankBoard.astro";
import PanelStrip from "../../../components/ds/PanelStrip.astro";
import SpecGrid from "../../../components/ds/SpecGrid.astro";
import { getEntries, getBoard, COHORTS, bandLegend, DIVISION_LABELS, ageOf, fmt, panelLabs } from "../../../lib/rankings";

const all = await getEntries();
const board = await getBoard();
const champion = all[0]?.slug ?? null;

const countIn = (key: string) => board[key]?.length ?? 0;

// The tab that opens is the fullest one, not the first.
//
// A board that opens on an empty tab looks broken regardless of how many
// companies sit on the other two. Small thing, but it stops the page lying
// about itself while the board is still filling up.
const opening = [...COHORTS].sort((a, b) => countIn(b.key) - countIn(a.key))[0]?.key ?? COHORTS[0].key;

/**
 * The board's own shape, as a datasheet.
 *
 * The hero was one column of prose against 600px of empty page — the only
 * top-level hero on the site with nothing on its right. It gets the same
 * treatment as the tool's landing hero: argument left, the thing itself right.
 * These are the board's real numbers rather than decoration, and they are the
 * two axes the board is meant to be read by (weight class and age) stated
 * before the reader meets a table sorted by neither.
 */
const divisionCounts = all.reduce<Record<string, number>>((acc, e) => {
  if (e.division) acc[e.division] = (acc[e.division] ?? 0) + 1;
  return acc;
}, {});
const divisionSummary = (["heavyweight", "middleweight", "lightweight"] as const)
  .filter((d) => divisionCounts[d])
  .map((d) => `${divisionCounts[d]} ${DIVISION_LABELS[d].toLowerCase()}`)
  .join(" · ");
const ages = all.map((e) => ageOf(e.founded_year)).filter((n) => n > 0);
const totals = all.map((e) => e.total);
const boardSpecs = [
  { label: "Ranked", value: `${all.length} ${all.length === 1 ? "company" : "companies"}` },
  divisionSummary ? { label: "Weight", value: divisionSummary } : null,
  ages.length ? { label: "Age", value: `${Math.min(...ages)}–${Math.max(...ages)} years` } : null,
  totals.length ? { label: "Scores", value: `${fmt(Math.min(...totals))}–${fmt(Math.max(...totals))} of 30` } : null,
  { label: "Panel", value: panelLabs() },
].filter((r): r is { label: string; value: string } => r !== null);

const title = "The Rank My AdTech leaderboard — private adtech startups, ranked";
const description = `${all.length} private adtech companies judged by three language models from three different labs, split by which side of the supply chain they sit on.`;
---

<Base title={title} description={description}
  ogImage="/og-rank-my-adtech.png" ogImageWidth={2400} ogImageHeight={1200}
  ogImageAlt="The Rank My AdTech leaderboard — private adtech startups ranked by a panel of language models.">
  <SiteHeader />
  <main>
    <section class="aol-rma__hero">
      <div class="aol-rma__inner aol-rma__split">
        <div class="aol-rma__copy">
          <p class="aol-eyebrow aol-rma__eyebrow">
            <PixelIcon name="trophy-solid" size={12} /> The board · {all.length} ranked
          </p>
          <h1 class="aol-rma__h1">The leaderboard.</h1>
          <p class="aol-rma__lede">
            Private adtech companies, judged by three models from three different labs.
            Split by which side of the supply chain they sit on, because an SSP and a
            measurement vendor are not doing the same job and should not share a table.
          </p>
          <p class="aol-rma__crosslink">
            <a href="/tools/rank-my-adtech/">Rank your own company →</a>
          </p>
        </div>

        <div class="aol-rma__boardcard">
          <p class="aol-eyebrow">What is on it</p>
          <SpecGrid specs={boardSpecs} />
        </div>
      </div>
    </section>

    {/* The board leads — on the page named "leaderboard", the leaderboard is
        the content, and the panel's credentials are the footnote to it. */}
    <section class="aol-rma__board aol-grid-blue">
      <div class="aol-rma__inner">
        <h2 class="aol-rma__h2" id="board">The board.</h2>
        <div class="aol-rt">
          {/* Inputs first: CSS selects forward only. */}
          {COHORTS.map((cohort) => (
            <input class="aol-rt__input" type="radio" name="cohort"
              id={`cohort-${cohort.key}`} checked={cohort.key === opening}
              aria-label={`${cohort.label} — ${countIn(cohort.key)} companies`} />
          ))}

          <div class="aol-rt__tabs" role="group" aria-labelledby="board">
            {COHORTS.map((cohort) => (
              <label class="aol-rt__tab" for={`cohort-${cohort.key}`}>
                <PixelIcon name={cohort.icon as any} size={24} />
                <span class="aol-rt__tab-name">{cohort.label}</span>
                <span class="aol-rt__tab-count">{countIn(cohort.key)}</span>
              </label>
            ))}
          </div>

          <div class="aol-rt__panels">
            {COHORTS.map((cohort) => (
              <div class="aol-rt__panel">
                <p class="aol-rt__blurb">{cohort.blurb}</p>
                <RankBoard entries={board[cohort.key] ?? []} championSlug={champion} limit={15} />
              </div>
            ))}
          </div>
        </div>

        {/* The figure's key — the row's marks, decoded once instead of hidden
            in title= attributes nobody on a phone can reach. */}
        <p class="aol-rt__legend">
          {/* Built from the scale rather than typed beside it — this line had
              already drifted from the labels it was explaining. */}
          {bandLegend()} · Ticks — each panelist's own total; scattered ticks
          are a split panel
        </p>

        {/* The dithered rule that sat here read as a rendering artifact at
            desktop width rather than as a separator. The legend above and the
            band's own hairline below already divide this. */}
        <p class="aol-rma__disclosure">
          <PixelIcon name="question-circle" size={12} /> Judged by three language models
          reading public pages, and written up by a fourth. An opinion, not research. Want a row gone?
          Email{" "}<a href="mailto:hello@andorlabs.ca?subject=Rank%20My%20AdTech%20removal">hello@andorlabs.ca</a>{" "}and it goes.
        </p>
      </div>
    </section>

    <section class="aol-rma__axes">
      <div class="aol-rma__inner">
        <PanelStrip />
      </div>
    </section>
  </main>
  <SiteFooter />
  <SiteMotion />
</Base>
