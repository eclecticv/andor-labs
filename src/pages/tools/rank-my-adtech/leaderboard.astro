---
/**
 * The full board — /tools/rank-my-adtech/leaderboard/
 *
 * A static sibling of [slug].astro. Astro resolves static routes before dynamic
 * ones, so this wins over a company whose slug happened to be "leaderboard";
 * the API also refuses that slug outright rather than relying on that.
 *
 * ── One table, not three tabs ──
 * The board used to split into a tab per cohort with the overflow folded into a
 * <details>, which was elegant at 28 companies and unreadable at 400. It is now
 * a single dense table: every company in one place, sortable by any column and
 * filterable by side or size class.
 *
 * The cost of that is real and worth naming: "3rd in emerging sell-side" was
 * literally a position in one section of one tab, so a reader could see where
 * the number came from without being told. That structure is gone from the
 * board and survives on the company page, which has room to say which cohort a
 * rank belongs to. What is bought is the comparison the tabs made impossible —
 * reading a dimension DOWN the whole board rather than across one company.
 *
 * Filters are enhancements, not the structure. Every row is in the HTML, so the
 * page is complete and crawlable with scripting off.
 */
import Base from "../../../layouts/Base.astro";
import SiteHeader from "../../../components/sections/SiteHeader.astro";
import SiteFooter from "../../../components/sections/SiteFooter.astro";
import SiteMotion from "../../../components/SiteMotion.astro";
import PixelIcon from "../../../components/ds/PixelIcon.astro";
import DitherLine from "../../../components/ds/DitherLine.astro";
import RankTable from "../../../components/ds/RankTable.astro";
import { getEntries, GRADER, DIMENSIONS } from "../../../lib/rankings";

const all = await getEntries();

const title = "The Rank My AdTech leaderboard — private adtech startups, graded";
const description = `${all.length} private adtech companies graded 1-5 on five dimensions by ${GRADER.name}, from their own websites.`;
---

<Base title={title} description={description}
  ogImage="/og-rank-my-adtech.png" ogImageWidth={2400} ogImageHeight={1200}
  ogImageAlt="The Rank My AdTech leaderboard — private adtech startups ranked by a panel of language models.">
  <SiteHeader />
  <main>
    <section class="aol-rma__hero">
      <div class="aol-rma__inner">
        <p class="aol-rma__eyebrow">
          <PixelIcon name="trophy-solid" size={12} /> The board · {all.length} graded
        </p>
        <h1 class="aol-rma__h1">The leaderboard.</h1>
        <p class="aol-rma__lede">
          Private adtech companies, graded 1–5 on five dimensions from their own
          websites and nothing else. Sort by any column; the interesting reading is
          down a column rather than across a row.
        </p>
        <p class="aol-rma__crosslink">
          <a href="/tools/rank-my-adtech/">Grade your own company →</a>
        </p>
      </div>
    </section>

    <section class="aol-rma__board">
      <div class="aol-rma__inner">
        <h2 class="aol-rma__h2" id="board">The board.</h2>
        <RankTable entries={all} />

        <DitherLine />
        <p class="aol-rma__disclosure">
          <PixelIcon name="question-circle" size={12} /> Graded by {GRADER.name} reading
          public pages — one model, one published rubric, temperature 0. An opinion with
          its reasoning attached, not research. Want a row gone? Email{" "}
          <a href="mailto:hello@andorlabs.ca?subject=Rank%20My%20AdTech%20removal">hello@andorlabs.ca</a>{" "}and it goes.
        </p>
      </div>
    </section>

    {/* The rubric, published in full. A grade is only auditable if the reader
        can see what was being asked — and with one grader there is no spread of
        opinions to imply a method, so the method has to be stated. */}
    <section class="aol-rma__axes">
      <div class="aol-rma__inner">
        <h2 class="aol-rma__h2">What is being graded.</h2>
        <ul class="aol-rma__axis-list">
          {DIMENSIONS.map((d) => (
            <li class="aol-rma__axis">
              <span class="aol-rma__axis-icon"><PixelIcon name={d.icon as any} size={22} /></span>
              <div class="aol-rma__axis-body">
                <h3 class="aol-rma__axis-name">{d.label}</h3>
                <p class="aol-rma__axis-q">{d.question}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="aol-rma__note">
          Each is an integer 1–5 against fixed anchors. The grade is their mean, to one
          decimal. Graded by {GRADER.lab} {GRADER.name} — {GRADER.spec}
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
  <SiteMotion />
</Base>
