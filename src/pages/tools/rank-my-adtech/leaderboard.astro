---
/**
 * The full board — /tools/rank-my-adtech/leaderboard/
 *
 * A static sibling of [slug].astro. Astro resolves static routes before dynamic
 * ones, so this wins over a company whose slug happened to be "leaderboard";
 * the API also refuses that slug outright rather than relying on that.
 *
 * Heavyweight first. Descending weight is how a fight card reads — main event
 * at the top — and it puts the companies people recognise where they look
 * first. Ten rows per division, the rest behind a <details> so they stay in the
 * HTML and stay crawlable.
 */
import Base from "../../../layouts/Base.astro";
import SiteHeader from "../../../components/sections/SiteHeader.astro";
import SiteFooter from "../../../components/sections/SiteFooter.astro";
import SiteMotion from "../../../components/SiteMotion.astro";
import PixelIcon from "../../../components/ds/PixelIcon.astro";
import DitherLine from "../../../components/ds/DitherLine.astro";
import RankBoard from "../../../components/ds/RankBoard.astro";
import { getEntries, categoryLabel } from "../../../lib/rankings";

const all = await getEntries();
const champion = all[0]?.slug ?? null;

const title = "The Rank My AdTech leaderboard — adtech companies ranked on innovation";
const description = `Every adtech company we have ranked on innovation, by weight class. ${all.length} companies judged by three language models each on paradigm, non-obviousness, the vibe-code test and conviction.`;
---

<Base title={title} description={description}
  ogImage="/og-rank-my-adtech.png" ogImageWidth={2400} ogImageHeight={1200}
  ogImageAlt="The Rank My AdTech leaderboard — adtech companies ranked on innovation by a panel of language models.">
  <SiteHeader />
  <main>
    <section class="aol-rma__hero">
      <div class="aol-rma__inner">
        <p class="aol-rma__eyebrow">
          <PixelIcon name="trophy-solid" size={12} /> The board · {all.length} ranked
        </p>
        <h1 class="aol-rma__h1">The leaderboard.</h1>
        <p class="aol-rma__lede">
          Every company we have scored, best first.
        </p>
        <p class="aol-rma__crosslink">
          <a href="/tools/rank-my-adtech/">Rank your own company →</a>
        </p>

        {/* Only categories that actually have companies. A nav listing nineteen
            categories where fifteen are empty advertises the emptiness. */}
        <ul class="aol-rma__jump">
          {[...new Set(all.map((e) => e.category))].filter(Boolean).slice(0, 8).map((c) => (
            <li>
              <a href={`#cat-${c}`}>
                {categoryLabel(c)}<em>{all.filter((e) => e.category === c).length}</em>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="aol-rma__board">
      <div class="aol-rma__inner">
        <DitherLine />
        <RankBoard entries={all} championSlug={champion} limit={20} />

        <p class="aol-rma__disclosure">
          <PixelIcon name="question-circle" size={12} /> Scored by a language model reading
          public pages. An opinion, meant to be funny, not research. Want a row gone?
          Email{" "}<a href="mailto:hello@andorlabs.ca?subject=Rank%20My%20AdTech%20removal">hello@andorlabs.ca</a>{" "}and it goes.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
  <SiteMotion />
</Base>
