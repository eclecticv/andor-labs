---
/**
 * One company's ranking — the page a board row links to, and the page that does
 * the organic-search work for this tool.
 *
 * ORDER IS DELIBERATE: share, the verdict, the case against, the five grades.
 *   - Score, band and the two ranks live in the HEADER, beside the company
 *     name rather than under it. They are one statement — the claim, the claim
 *     in words, the claim in context — and setting them in the header's right
 *     column costs no vertical space, so the verdict starts near the top of the
 *     page instead of a screen down it.
 *   - Share sits high, at peak reaction. A share row at the bottom of a long
 *     page is a share row nobody reaches.
 *   - The verdict leads, because it is what the reader came for. Everything
 *     after it exists to be checked against it.
 *   - Then the case AGAINST the company, which the grader wrote before it had
 *     scored anything. Under the panel, the interesting content here was three
 *     labs disagreeing; with one grader there is no disagreement to show, and
 *     this is the honest replacement. It is also the strongest evidence the
 *     page carries that the grade was argued rather than felt.
 *   - The five grades go last, as the working. They are the evidence behind the
 *     verdict, and evidence is what you turn to after a conclusion you want to
 *     check — not the thing to wade through on the way to one.
 *
 * The commercial "here is what would raise your score" layer is deliberately
 * absent. This board's whole claim is neutrality, and a scoring page that also
 * sells the fix is not neutral no matter how the advice is worded.
 *
 * Generated at build time from D1. Every string here came off a third-party
 * homepage by way of a language model, so it is untrusted — Astro escapes
 * `{expr}` interpolation, which is what keeps that safe. No set:html here.
 */
import Base from "../../../layouts/Base.astro";
import SiteHeader from "../../../components/sections/SiteHeader.astro";
import SiteFooter from "../../../components/sections/SiteFooter.astro";
import SiteMotion from "../../../components/SiteMotion.astro";
import PixelIcon from "../../../components/ds/PixelIcon.astro";
import DitherLine from "../../../components/ds/DitherLine.astro";
import {
  getEntries, ranksFor, ordinal, scoreBand, stackFor, categoryLabel,
  fmt, bandBadgeFor, isStaleGrade, letterFor, reasonsFor, caseAgainstFor,
  scoresFor, DIMENSIONS, GRADER, SIDE_LABELS,
} from "../../../lib/rankings";

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, all: entries },
  }));
}

const { entry, all } = Astro.props;
const band = scoreBand(entry.grade);
const letter = letterFor(entry.grade);
const ranks = ranksFor(entry, all);
const stack = stackFor(entry);
const stackCount = Object.values(stack).reduce((n, tools) => n + tools.length, 0);

const bandBadge = bandBadgeFor(entry);

/* Every grade on the board comes from the same pinned model, so this is false
   for anything graded since the pin. It exists for the day the pin moves: at
   that moment every existing row was graded by a different instrument, and a
   page that cannot say so is quietly comparing incomparable numbers. */
const graderStale = isStaleGrade(entry.model_used);

const scores = scoresFor(entry);
const reasons = reasonsFor(entry);
const caseAgainst = caseAgainstFor(entry);

const title = `${entry.name} — Rank My AdTech — And/or Labs`;
const description = `${entry.name} grades ${fmt(entry.grade)}/5 (${letter}) on Rank My AdTech: ${ordinal(ranks.cohortRank)} of ${ranks.cohortSize} in ${ranks.cohortLabel}, graded on five dimensions by ${GRADER.name}.`;

const pageUrl = new URL(`/tools/rank-my-adtech/${entry.slug}/`, Astro.site).href;
const shareBrag =
  entry.grade >= 4.5
    ? "Top of the class. Go and gloat."
    : entry.grade >= 3.5
      ? "Good number. Post it before we change our mind."
      : entry.grade >= 2.5
        ? "Respectable. We have been meaner."
        : "Brutal. Posting it anyway is the power move.";

const shareText = `${entry.name} graded ${letter} (${fmt(entry.grade)}/5) on Rank My AdTech — ${ordinal(ranks.cohortRank)} in ${ranks.cohortLabel}.`;
const xHref = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`;
const liHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
---

<Base
  title={title}
  description={description}
  ogImage={`/og/rank/${entry.slug}.png`}
  ogImageWidth={1200}
  ogImageHeight={600}
  ogImageAlt={`${entry.name} grades ${fmt(entry.grade)} out of 5 on Rank My AdTech.`}
>
  <SiteHeader />
  <main>
    <section class="aol-rmc">
      <div class="aol-rma__inner">
        <p class="aol-rmc__back"><a href="/tools/rank-my-adtech/leaderboard/">← The board</a></p>

        <header class="aol-rmc__head">
          {entry.logo_url ? (
            <img class="aol-rmc__logo" src={entry.logo_url} alt="" width="56" height="56" />
          ) : null}
          <div class="aol-rmc__id">
            <h1 class="aol-rmc__name">{entry.name}</h1>
            {entry.one_liner ? <p class="aol-rmc__one-liner">{entry.one_liner}</p> : null}
            <p class="aol-rmc__meta">
              <span>{SIDE_LABELS[entry.side]}</span>
              <span>·</span>
              <span>{categoryLabel(entry.category)}</span>
              {/* Stage lives in the band-note below the ranks — printing it here
                  too said the same thing twice within 200px. */}
              {entry.provisional ? (
                <span class="aol-rb__provisional">
                  <PixelIcon name="question-circle" size={12} /> provisional
                </span>
              ) : null}
            </p>
          </div>

          {/*
            The stats, in the header's right-hand column.

            They were a full-width row under the header, which left the space
            beside the company name empty and pushed everything below the fold
            by the height of a whole band. Set here they cost no vertical space
            at all: the identity reads left, the numbers read right, and the two
            halves of "who is this and how did it do" sit on the same line.

            Score, then band, then ranks — the claim, the claim in words, the
            claim in context.
          */}
          <div class="aol-rmc__stats">
            <p class="aol-rmc__score">
              <span class="aol-rmc__total">{fmt(entry.grade)}</span>
              <span class="aol-rmc__out">/5 · {letter}</span>
            </p>
            <p class="aol-rmc__vr-band">
              <span class:list={["aol-rmc__band", band.solid && "aol-rmc__band--solid"]}>
                <PixelIcon name={band.icon as any} size={24} />
              </span>
              <span class:list={["aol-rmc__band-word", band.solid && "aol-rmc__band-word--solid"]}>
                {band.label}
              </span>
            </p>
            <ul class="aol-rmc__ranks">
              <li class="aol-rmc__rank">
                <span class="aol-rmc__rank-n">{ordinal(ranks.cohortRank)}</span>
                <span class="aol-rmc__rank-of">
                  of {ranks.cohortSize} in {ranks.cohortLabel}
                </span>
              </li>
              <li class="aol-rmc__rank">
                <span class="aol-rmc__rank-n">{ordinal(ranks.categoryRank)}</span>
                <span class="aol-rmc__rank-of">
                  of {ranks.categorySize} in {ranks.categoryLabel}
                </span>
              </li>
            </ul>
          </div>
        </header>

        {/* Shown only when evidenced — see bandBadgeFor. An inferred band
            printed the same way as a real one would be the page overstating
            what it knows, and stage is stated on well under a fifth of adtech
            sites, so that would be the common case rather than the edge. */}
        {bandBadge ? (
          <p class="aol-rmc__band-note">
            <PixelIcon name="flag" size={12} />
            <span>{bandBadge.label} stage. {bandBadge.evidence}</span>
          </p>
        ) : null}

        <DitherLine />

        {/* ── 2. Share ───────────────────────────────────────────────────── */}
        <div class="aol-rmc__share">
          <p class:list={["aol-rmc__share-label", band.solid && "aol-rmc__share-label--solid"]}>
            {/* The band's own glyph — a blue trophy over "Brutal." was gloating. */}
            <PixelIcon name={band.icon as any} size={24} />
            {shareBrag}
          </p>
          {/* Mark plus one word. The buttons were three full-size shadowed
              blocks reading "Post on X" / "Post on LinkedIn" / "Copy link",
              which is a lot of furniture for a secondary action sitting
              directly under the score. The brand marks say "post to X" faster
              than the words did, so the words shrink to the verb. Icons at 12
              rather than 24, per the icon sizes the system publishes. */}
          <p class="aol-rmc__share-actions">
            {/* The visible label is just "Post" on both — the mark carries which
                network. aria-label restores that for anyone who cannot see the
                mark, who would otherwise hear "Post link, Post link" and have no
                way to tell the two apart. */}
            <a class="aol-btn aol-btn--secondary aol-btn--sm" href={xHref}
              target="_blank" rel="noopener" aria-label="Post on X">
              <PixelIcon name="x" size={12} /> Post
            </a>
            <a class="aol-btn aol-btn--secondary aol-btn--sm" href={liHref}
              target="_blank" rel="noopener" aria-label="Post on LinkedIn">
              <PixelIcon name="linkedin" size={12} /> Post
            </a>
            <button class="aol-btn aol-btn--secondary aol-btn--sm" type="button" data-copy={pageUrl} aria-live="polite">
              Copy link
            </button>
          </p>
        </div>

        <DitherLine />

        {/* ── 3. What the grader came to ─────────────────────────────────── */}
        <h2 class="aol-rmc__h2">The verdict.</h2>
        {/* Same call as the grades. There is no separate writer any more: five
            grades from one model need no synthesis, and the paragraph was
            produced by the grader that had already written the case against. */}
        <p class="aol-rmc__verdict">{entry.summary}</p>

        {/* ── 4. The case against, written before any score existed ─────── */}
        {caseAgainst.length ? (
          <section class="aol-rmc__against">
            <h2 class="aol-rmc__h2">The case against.</h2>
            {/* Printed BEFORE the grades, in the order it was produced. The
                grader wrote these with no score in hand, which is the entire
                reason they are worth reading: marketing language survives "why
                is this good" — it is built to — and does not survive "what is
                the hard part here" asked before anyone has committed. */}
            <p class="aol-rmc__against-note">
              Written by the grader before it scored anything, from the pages only.
            </p>
            <ol class="aol-rmc__against-list">
              {caseAgainst.map((line) => <li class="aol-rmc__against-item">{line}</li>)}
            </ol>
          </section>
        ) : null}

        {/* ── 5. The five grades, as the working ─────────────────────────── */}
        <section class="aol-rmc__grades">
          <h2 class="aol-rmc__h2">The working.</h2>

          {graderStale ? (
            <p class="aol-rmc__stale">
              Graded by an earlier model, before the current grader was pinned. Its
              numbers are not comparable to rows graded since — due a re-grade.
            </p>
          ) : null}

          <ul class="aol-rmc__dims">
            {DIMENSIONS.map((d) => (
              <li class="aol-rmc__dim">
                <div class="aol-rmc__dim-head">
                  <span class="aol-rmc__dim-icon"><PixelIcon name={d.icon as any} size={20} /></span>
                  <h3 class="aol-rmc__dim-name">{d.label}</h3>
                  <span class="aol-rmc__dim-score">
                    <span class="aol-rmc__dim-n">{scores[d.key]}</span>
                    <span class="aol-rmc__dim-of">/5</span>
                  </span>
                </div>
                <p class="aol-rmc__dim-q">{d.question}</p>
                {reasons[d.key] ? (
                  <p class="aol-rmc__dim-reason">{reasons[d.key]}</p>
                ) : null}
                <span class="aol-rmc__dim-bar" style={`--n:${scores[d.key]}`} aria-hidden="true"></span>
              </li>
            ))}
          </ul>

          {/* The grader, named with its published specs. A score from an
              unnamed "AI" is an appeal to authority with no authority behind
              it — and with one grader there is no panel to hide behind. */}
          <div class="aol-rmc__grader">
            <p class="aol-rmc__grader-label">Graded by</p>
            <p class="aol-rmc__grader-name">{GRADER.lab} {GRADER.name}</p>
            <p class="aol-rmc__grader-spec">{GRADER.spec}</p>
            <p class="aol-rmc__grader-method">
              One model, temperature 0, against anchored 1–5 scales. Pinned: a grader
              that cannot answer fails the ranking rather than being substituted,
              because a board whose rows were graded by different models is not
              comparable to itself.
            </p>
          </div>
        </section>

        {/* ── 6. What we could see ───────────────────────────────────────── */}
        {stackCount ? (
          <>
            <DitherLine />
            <h2 class="aol-rmc__h2">The stack we could see.</h2>
            <p class="aol-rmc__note">
              Read from the markup, so browser-side tools only. A warehouse-native setup
              looks empty here and may still be excellent. The grader was not shown
              this — it is here as context, not as evidence.
            </p>
            <ul class="aol-rmc__stack">
              {Object.entries(stack).map(([category, tools]) => (
                <li class="aol-rmc__stack-row">
                  <span class="aol-rmc__stack-cat">{category.replace(/-/g, " ")}</span>
                  <span class="aol-rmc__stack-tools">
                    {tools.map((t) => <span class="aol-rb__keyword">{t}</span>)}
                  </span>
                </li>
              ))}
            </ul>
          </>
        ) : null}

        <DitherLine />
        <p class="aol-rma__disclosure">
          <PixelIcon name="question-circle" size={12} /> Written by language models reading
          public pages. An opinion, and meant to be funny. Not research. Want this page gone?
          Email{" "}<a href={`mailto:hello@andorlabs.ca?subject=Rank%20My%20AdTech%20removal%3A%20${entry.name}`}>hello@andorlabs.ca</a>{" "}and it goes.
        </p>
        <p class="aol-rma__crosslink">
          <a href="/tools/rank-my-adtech/">Rank another company →</a>
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
  <SiteMotion />
</Base>

<script>
  // Copy-link. Confirms in place — a native dialog here would block the page
  // and is the wrong weight for "copied".
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = btn.dataset.copy;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = original; }, 1600);
      } catch {
        btn.textContent = "Press ⌘C";
      }
    });
  });
</script>
