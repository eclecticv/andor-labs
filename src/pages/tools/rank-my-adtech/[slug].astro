---
/**
 * One company's ranking — the page a leaderboard row links to, and the page
 * that does the organic-search work for this tool.
 *
 * ORDER IS DELIBERATE: verdict, share, panel, scoring.
 *   - The verdict is what the reader came for, so it goes first.
 *   - Share sits directly under it, at the moment of peak reaction. A share row
 *     at the bottom of the page is a share row nobody reaches.
 *   - The panel is the evidence for the verdict, so it follows the claim.
 *   - Scoring is the arithmetic behind the evidence, and goes last: a reader
 *     who wants the number already saw it in the header.
 *
 * Generated at build time from D1. A company whose status is `removed` is
 * excluded from the query and has no page at all, which resolves as a 404
 * rather than the 410 a server-rendered site could return.
 *
 * Every string here originated on a third-party homepage and passed through a
 * language model. Astro escapes `{expr}` interpolation, which is what keeps
 * that safe — do not reach for set:html on this page.
 */
import Base from "../../../layouts/Base.astro";
import SiteHeader from "../../../components/sections/SiteHeader.astro";
import SiteFooter from "../../../components/sections/SiteFooter.astro";
import SiteMotion from "../../../components/SiteMotion.astro";
import PixelIcon from "../../../components/ds/PixelIcon.astro";
import DitherLine from "../../../components/ds/DitherLine.astro";
import { getEntries, getJurors, scoreBand, AXES, DIVISIONS } from "../../../lib/rankings";

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry, index) => ({
    params: { slug: entry.slug },
    props: { entry, overallRank: index + 1, total: entries.length },
  }));
}

const { entry, overallRank, total: boardSize } = Astro.props;
const jurors = await getJurors(entry.slug);
const band = scoreBand(entry.total);
const division = DIVISIONS.find((d) => d.key === entry.division)!;

const title = `${entry.name} — Rank My AdTech — And/or Labs`;
const description = `${entry.name} scores ${entry.total}/100 on Rank My AdTech: paradigm ${entry.paradigm}, non-obviousness ${entry.non_obviousness}, vibe-code ${entry.vibe_code}, conviction ${entry.conviction}. Judged by ${jurors.length} models.`;

const pageUrl = new URL(`/tools/rank-my-adtech/${entry.slug}/`, Astro.site).href;
const shareBrag =
  entry.total >= 85
    ? "Top of the class. Go and gloat."
    : entry.total >= 70
      ? "That is a good number. Post it before the panel changes its mind."
      : entry.total >= 40
        ? "Respectable. The panel has been considerably meaner."
        : "Brutal. Posting it anyway is the power move.";

const shareText = `${entry.name} scored ${entry.total}/100 on Rank My AdTech — judged by three models on whether it is actually innovative.`;
const xHref = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`;
const liHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;

const axisValue = (key: string) =>
  ({
    paradigm: entry.paradigm,
    non_obviousness: entry.non_obviousness,
    vibe_code: entry.vibe_code,
    conviction: entry.conviction,
  })[key] ?? 0;
---

<Base
  title={title}
  description={description}
  ogImage={`/og/rank/${entry.slug}.png`}
  ogImageWidth={1200}
  ogImageHeight={600}
  ogImageAlt={`${entry.name} scores ${entry.total} out of 100 on Rank My AdTech, in the ${entry.division} division.`}
>
  <SiteHeader />
  <main>
    <section class="aol-rmc">
      <div class="aol-rma__inner">
        <p class="aol-rmc__back"><a href="/tools/rank-my-adtech/leaderboard/">← The board</a></p>

        <header class="aol-rmc__head">
          {entry.logo_url ? (
            <img class="aol-rmc__logo" src={entry.logo_url} alt="" width="56" height="56" />
          ) : null}
          <div class="aol-rmc__id">
            <h1 class="aol-rmc__name">{entry.name}</h1>
            {entry.one_liner ? <p class="aol-rmc__one-liner">{entry.one_liner}</p> : null}
            <p class="aol-rmc__meta">
              <span class="aol-rmc__division">
                <PixelIcon name={division.icon as any} size={12} /> {division.label}
              </span>
              <span>·</span>
              <span>#{overallRank} of {boardSize} overall</span>
              {entry.founded_year ? (<><span>·</span><span>founded {entry.founded_year}</span></>) : null}
              {entry.provisional ? (
                <span class="aol-rb__provisional">
                  <PixelIcon name="question-circle" size={12} /> provisional
                </span>
              ) : null}
            </p>
          </div>
          <div class="aol-rmc__score">
            <span class:list={["aol-rmc__band", band.solid && "aol-rb__band--solid"]}>
              <PixelIcon name={band.icon as any} size={36} />
            </span>
            <span class="aol-rmc__total">{entry.total}</span>
            <span class="aol-rmc__out">/100</span>
          </div>
        </header>

        {/* ── Who was on duty ─────────────────────────────────────────────
            Named upfront, before the verdict. The whole claim of this tool is
            WHO judged you, and burying the model names under the reasoning
            makes the panel feel like a stylistic flourish rather than the
            method. */}
        <ul class="aol-rmc__duty">
          {jurors.map((j) => (
            <li class="aol-rmc__duty-item">
              <PixelIcon name="robot" size={12} />
              <span class="aol-rmc__duty-model">{j.model_id}</span>
              <span class="aol-rmc__duty-lens">as the {j.lens}</span>
              {j.keyword ? <span class="aol-rmc__duty-kw">{j.keyword}</span> : null}
            </li>
          ))}
        </ul>

        <DitherLine />

        {/* ── 1. The verdict ─────────────────────────────────────────────── */}
        <h2 class="aol-rmc__h2">The verdict.</h2>
        <p class="aol-rmc__verdict">{entry.verdict}</p>
        {entry.split_note ? (
          <p class="aol-rmc__split">
            <PixelIcon name="vote-yeah" size={12} />{entry.split_note}
          </p>
        ) : null}

        {/* ── 2. Share, at peak reaction ─────────────────────────────────── */}
        <div class="aol-rmc__share">
          <p class="aol-rmc__share-label">
            <PixelIcon name="trophy-solid" size={24} />
            {shareBrag}
          </p>
          <p class="aol-rmc__share-actions">
            <a class="aol-rmc__share-btn" href={xHref} target="_blank" rel="noopener">Post on X</a>
            <a class="aol-rmc__share-btn" href={liHref} target="_blank" rel="noopener">Share on LinkedIn</a>
            <button class="aol-rmc__share-btn" type="button" data-copy={pageUrl}>Copy link</button>
          </p>
        </div>

        <DitherLine />

        {/* ── 3. The panel, in full ──────────────────────────────────────── */}
        <h2 class="aol-rmc__h2">The panel.</h2>
        <p class="aol-rmc__note">
          Three models from three different labs judged this independently, without seeing
          each other's answers. A fourth read all three and wrote the verdict above.
        </p>
        <ul class="aol-rmc__jurors">
          {jurors.map((juror) => (
            <li class="aol-rmc__juror">
              <span class="aol-rmc__juror-mark"><PixelIcon name="quote-left" size={24} /></span>
              <span class="aol-rmc__juror-body">
                <span class="aol-rmc__juror-by">
                  {juror.model_id} · as the {juror.lens}
                  {juror.keyword ? <em class="aol-rmc__juror-kw">{juror.keyword}</em> : null}
                </span>
                {juror.quote ? <span class="aol-rmc__juror-quote">{juror.quote}</span> : null}
                {juror.reasoning ? (
                  <span class="aol-rmc__juror-reasoning">{juror.reasoning}</span>
                ) : null}
              </span>
            </li>
          ))}
        </ul>

        <DitherLine />

        {/* ── 4. The arithmetic ──────────────────────────────────────────── */}
        <h2 class="aol-rmc__h2">The scoring.</h2>
        <p class="aol-rmc__note">
          Each axis is the panel's average, and the total is their sum. The number is
          arithmetic; only the words above are written.
        </p>
        <ul class="aol-rmc__axes">
          {AXES.map((axis) => {
            const value = axisValue(axis.key);
            return (
              <li class="aol-rmc__axis">
                <span class="aol-rmc__axis-icon"><PixelIcon name={axis.icon as any} size={24} /></span>
                <span class="aol-rmc__axis-name">{axis.label}</span>
                <span class="aol-rmc__meter" role="img" aria-label={`${value} out of ${axis.max}`}>
                  <span class="aol-rmc__meter-fill"
                    style={`width:${((value / axis.max) * 100).toFixed(1)}%`} />
                </span>
                <span class="aol-rmc__axis-score">{value}<em>/{axis.max}</em></span>
                <span class="aol-rmc__axis-q">{axis.question}</span>
              </li>
            );
          })}
        </ul>

        {entry.platform_note ? (
          <>
            <h2 class="aol-rmc__h2">Not scored, but noted.</h2>
            <p class="aol-rmc__note">{entry.platform_note}</p>
          </>
        ) : null}

        <DitherLine />
        <p class="aol-rma__disclosure">
          <PixelIcon name="question-circle" size={12} /> Generated by language models reading
          a public homepage. An opinion, meant to be funny, and not research. Want this page
          gone? Email
          <a href={`mailto:hello@andorlabs.ca?subject=Rank%20My%20AdTech%20removal%3A%20${entry.name}`}>hello@andorlabs.ca</a>
          and it goes.
        </p>
        <p class="aol-rma__crosslink">
          <a href="/tools/rank-my-adtech/">Rank another company →</a>
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
  <SiteMotion />
</Base>

<script>
  // Copy-link. Confirms in place rather than firing an alert — a native dialog
  // here would block the page and is the wrong weight for "copied".
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = btn.dataset.copy;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = original; }, 1600);
      } catch {
        btn.textContent = "Press ⌘C";
      }
    });
  });
</script>
