---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import SiteMotion from "../components/SiteMotion.astro";
import CopyDiffer from "../components/CopyDiffer.astro";
import Leaderboard from "../components/ds/Leaderboard.astro";
import type { LeaderboardCategory } from "../components/ds/Leaderboard.astro";

// ── Organic Discovery Leaderboard — data ──
// Source: Sheet_1_export.csv, run 2026-07-17. Each vendor carries its two 0–10
// component scores; the component derives Combo = average (one decimal) and shows
// the row as `search · ai → combo`. Baseline run: no prior period, so `move` is
// omitted (renders "—"). Movement begins next update, diffed against these ranks.
const CATEGORIES: LeaderboardCategory[] = [
  { name: "Publisher Monetization", entries: [
    { name: "Raptive", search: 6, ai: 9 }, { name: "Mediavine", search: 6, ai: 7 },
    { name: "Ezoic", search: 7, ai: 7 }, { name: "Freestar", search: 5, ai: 8 },
    { name: "MonetizeMore", search: 8, ai: 6 } ] },
  { name: "Paywall & Subscriptions", entries: [
    { name: "Piano", search: 6, ai: 9 }, { name: "Zuora (Zephr)", search: 3, ai: 6 },
    { name: "Pelcro", search: 5, ai: 7 }, { name: "Chargebee", search: 4, ai: 4 },
    { name: "Leaky Paywall", search: 7, ai: 6 } ] },
  { name: "Supply-Side Platforms", entries: [
    { name: "Magnite", search: 6, ai: 9 }, { name: "PubMatic", search: 6, ai: 8 },
    { name: "Index Exchange", search: 5, ai: 7 }, { name: "OpenX", search: 5, ai: 7 },
    { name: "Google", search: 7, ai: 7 } ] },
  { name: "Ad Servers", entries: [
    { name: "Google", search: 8, ai: 9 }, { name: "Kevel", search: 6, ai: 7 },
    { name: "OpenX", search: 5, ai: 6 }, { name: "Broadstreet", search: 4, ai: 5 },
    { name: "AdButler", search: 7, ai: 6 } ] },
  { name: "CMS", entries: [
    { name: "WordPress", search: 8, ai: 7 }, { name: "Adobe", search: 7, ai: 9 },
    { name: "Contentful", search: 7, ai: 8 }, { name: "Sitecore", search: 5, ai: 7 },
    { name: "Drupal", search: 6, ai: 6 } ] },
  { name: "Consent Management (CMP)", entries: [
    { name: "OneTrust", search: 7, ai: 9 }, { name: "Usercentrics", search: 8, ai: 8 },
    { name: "Didomi", search: 7, ai: 7 }, { name: "Sourcepoint", search: 5, ai: 5 },
    { name: "TrustArc", search: 5, ai: 6 } ] },
  { name: "Ad Fraud & Traffic Quality", entries: [
    { name: "DoubleVerify", search: 6, ai: 9 }, { name: "Integral Ad Science", search: 6, ai: 8 },
    { name: "HUMAN Security", search: 5, ai: 7 }, { name: "Pixalate", search: 6, ai: 5 },
    { name: "Fraudlogix", search: 6, ai: 4 } ] },
  { name: "Adblock Revenue Recovery", entries: [
    { name: "Admiral", search: 8, ai: 8 }, { name: "Blockthrough", search: 7, ai: 9 },
    { name: "AdRecover", search: 6, ai: 4 }, { name: "Ad-Shield", search: 6, ai: 4 },
    { name: "AdPushup", search: 6, ai: 4 } ] },
  { name: "Identity & Alt ID", entries: [
    { name: "LiveRamp", search: 7, ai: 9 }, { name: "The Trade Desk", search: 5, ai: 8 },
    { name: "ID5", search: 4, ai: 5 }, { name: "Lotame", search: 4, ai: 5 },
    { name: "Experian", search: 5, ai: 5 } ] },
  { name: "Native Advertising", entries: [
    { name: "Taboola", search: 8, ai: 9 }, { name: "Outbrain", search: 7, ai: 9 },
    { name: "Nativo", search: 5, ai: 7 }, { name: "MGID", search: 5, ai: 6 },
    { name: "Revcontent", search: 5, ai: 5 } ] },
  { name: "Header Bidding Wrappers", entries: [
    { name: "Prebid", search: 8, ai: 10 }, { name: "Amazon Publisher Services", search: 6, ai: 8 },
    { name: "Magnite", search: 4, ai: 5 }, { name: "PubMatic", search: 5, ai: 5 },
    { name: "Google", search: 6, ai: 6 } ] },
];

const nCat = CATEGORIES.length;
const nVendor = CATEGORIES.reduce((s, c) => s + c.entries.length, 0);
---
<Base
  title="Organic Discovery Leaderboard — And/or Labs"
  description="How adtech vendors rank on organic search visibility and AI citation rank across Google, Claude, ChatGPT, and Perplexity — a blended 0–10 discovery score, by category."
>
  <SiteHeader />
  <main>
    <section class="aol-lbpage" style="background:var(--paper)">
      <div class="aol-lbpage__inner" style="max-width:var(--container-width);width:100%;margin:0 auto;padding:0 var(--gutter) var(--section-pad-y)">
        <Leaderboard
          title="Organic Discovery Leaderboard."
          subtitle="Every vendor scored 0–10 on organic search visibility and AI-citation rank for broad category queries across Google, Claude, ChatGPT, Perplexity, and others; the two average to a Combo Score. Baseline run — month-over-month movement begins next update."
          version="BASELINE — JUL 17, 2026"
          categories={CATEGORIES}
          columns={3}
          numbered={false}
          rule={false}
          showMove={false}
          class="aol-lb--filled"
          metaLabel="MOM"
          scoreLabel="SEARCH × AI → COMBO"
        />

        <div class="aol-lbpage__caption">
          <span class="fig">FIG. 01</span>
          <span class="dot">&#x2504;&#x2504;</span>
          <span>{nCat} categories &middot; {nVendor} vendors &middot; ranked 1&ndash;5 &middot; baseline &mdash; no prior period</span>
        </div>

        <div class="aol-lbpage__note">
          <p>
            <span class="aol-eyebrow aol-eyebrow--strong aol-lbpage__note-k">Methodology</span>
            For each category, broad searches (<i>&ldquo;best [category] platforms&rdquo;</i>, <i>&ldquo;top [category] vendors 2026&rdquo;</i>) surface the vendors named most consistently; brands are de-duplicated to the parent company (AdThrive and CafeMedia both roll up to Raptive) and the five most prominent make the shortlist.
          </p>
          <p>
            <span class="aol-eyebrow aol-eyebrow--strong aol-lbpage__note-k">Scoring</span>
            <strong>Search Visibility</strong> (0&ndash;10) — how consistently the vendor&rsquo;s own domain, not third-party review sites, ranks in organic search across the category&rsquo;s query variants. <strong>AI Citation Rank</strong> (0&ndash;10) — how often and how prominently it&rsquo;s named by AI answer engines. <strong>Combo</strong> — the average of the two, rounded to one decimal; the number to watch, shown per row as <span class="ex">search &times; AI &rarr; combo</span>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <SiteMotion />
  {import.meta.env.DEV && <CopyDiffer />}
</Base>

<style>
  .aol-lbpage__caption {
    display: flex; align-items: center; gap: 10px;
    margin-top: 22px; padding-top: 14px;
    border-top: 1px dotted var(--ink-300);
    font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.06em;
    color: var(--text-faint); text-transform: uppercase;
  }
  .aol-lbpage__caption .fig { color: var(--ink-900); }
  .aol-lbpage__caption .dot { color: var(--blue-500); }
  /* .aol-lbpage__note styles are global in components.css (scoped rules didn't bind reliably). */
</style>
