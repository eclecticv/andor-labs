---
// RankBoard — one ranked list.
//
// Flat by design. The leaderboard already splits companies by the BOARD_AXIS
// cohort into tabs; splitting again inside a tab would mean nineteen
// subcategory headings over a dozen companies, which is a page of empty
// headings. Each row carries its own category chip instead, and grouping can
// return when a single category can fill a table on its own.
//
// Styles live in src/styles/components.css (.aol-rb__*).
import RankRow from "./RankRow.astro";
import type { Entry } from "../../lib/rankings";

interface Props {
  entries: Entry[];
  championSlug?: string | null;
  /** Rows shown before the rest fold into a disclosure. */
  limit?: number;
}
const { entries, championSlug = null, limit = 0 } = Astro.props;
const shown = limit > 0 ? entries.slice(0, limit) : entries;
const rest = limit > 0 ? entries.slice(limit) : [];

// A row tied with the one above says so — three 17.3s rendered as ranks 5/6/7
// imply an ordering the panel never made.
const tiedWithPrev = (i: number, list: Entry[], prev?: Entry) =>
  i > 0 ? list[i - 1].total === list[i].total : prev ? prev.total === list[i].total : false;
---

<div class="aol-rb">
  {entries.length === 0 ? (
    <p class="aol-rb__empty">
      Nobody in this section yet — the first company ranked here takes the top of it.{" "}
      <a href="/tools/rank-my-adtech/">Rank your company →</a>
    </p>
  ) : (
    <>
      <ol class="aol-rb__list">
        {shown.map((entry, i) => (
          <RankRow entry={entry} rank={i + 1} leader={i === 0}
            tied={tiedWithPrev(i, shown)}
            champion={entry.slug === championSlug} />
        ))}
      </ol>

      {/* <details> rather than a JS toggle: the hidden rows stay in the HTML,
          so they remain crawlable and work with scripting off. */}
      {rest.length ? (
        <details class="aol-rb__more">
          <summary class="aol-rb__more-toggle">Show the other {rest.length}</summary>
          <ol class="aol-rb__list">
            {rest.map((entry, i) => (
              <RankRow entry={entry} rank={limit + i + 1}
                tied={tiedWithPrev(i, rest, shown[shown.length - 1])}
                champion={entry.slug === championSlug} />
            ))}
          </ol>
        </details>
      ) : null}
    </>
  )}
</div>
