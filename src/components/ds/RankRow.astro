---
// One leaderboard row. Extracted so the preview on the landing page, the
// sectioned tables on the leaderboard, and the rows hidden behind "show the
// rest" are all literally the same markup — three near-copies of a row is how
// a board starts drifting between the places it appears.
import PixelIcon from "./PixelIcon.astro";
import { scoreBand, categoryLabel, adjectivesFor, fmt, DIVISION_LABELS, type Entry } from "../../lib/rankings";

interface Props {
  entry: Entry;
  rank: number;
  /** Section leader — takes the crown. */
  leader?: boolean;
  /** Best score on the whole board — takes the trophy instead. */
  champion?: boolean;
  /** Same total as the row above — rendered as "=N". */
  tied?: boolean;
}
const { entry, rank, leader = false, champion = false, tied = false } = Astro.props;
const band = scoreBand(entry.total);

// One word from each panelist, in panel order. Three labs disagreeing in
// public is the row's actual payload — a score says how a company did, three
// words say how much the room agreed about it.
const adjectives = adjectivesFor(entry);

// Each panelist's own total /30, for the spread figure. Three ticks clustered
// is agreement; three ticks scattered is the split, drawn instead of labeled.
const takeTotals = (entry.takes ?? []).map(
  (t) => (t.innovation ?? 0) + (t.difficulty ?? 0) + (t.outlook ?? 0),
);
const isSplit = entry.split_spread >= 3;
---

<li class="aol-rb__row">
  <a class="aol-rb__link" href={`/tools/rank-my-adtech/${entry.slug}/`}>
    <span class="aol-rb__rank" data-tied={tied || undefined}>{rank}</span>

    {entry.logo_url ? (
      <img class="aol-rb__logo" src={entry.logo_url} alt="" width="28" height="28"
        loading="lazy" decoding="async" />
    ) : (
      <span class="aol-rb__logo aol-rb__logo--blank" aria-hidden="true" />
    )}

    <span class="aol-rb__body">
      <span class="aol-rb__name">
        {entry.name}
        {champion ? (
          <PixelIcon name="trophy-solid" size={12} class="aol-rb__trophy" aria-label="Top score on the board" />
        ) : leader ? (
          <PixelIcon name="crown-solid" size={12} class="aol-rb__crown" aria-label="Top of its side" />
        ) : null}
        {entry.provisional ? (
          <span class="aol-rb__provisional" title="Too little on the site to judge properly">
            <PixelIcon name="question-circle" size={12} /> provisional
          </span>
        ) : null}
      </span>

      {/* Category and the panel's three words, not the one-liner. The one-liner
          is the company's own description of itself and every row of it reads
          the same. */}
      <span class="aol-rb__keywords">
        <span class="aol-rb__keyword aol-rb__keyword--cat">{categoryLabel(entry.category)}</span>
        {/* Weight class, from headcount. It sits with the category rather than
            in its own column because it is the same KIND of fact — what this
            company is — and a reader scanning the board wants to know they are
            not comparing nine people to nine hundred. Absent when the lookup
            established no size; the row never guesses one. */}
        {entry.division ? (
          <span class="aol-rb__keyword aol-rb__keyword--class"
            title={entry.headcount ? `${entry.headcount} people` : undefined}>
            {DIVISION_LABELS[entry.division].toLowerCase()}
          </span>
        ) : null}
        {adjectives.map(({ word, count }) => (
          <span class="aol-rb__keyword"
            title={count > 1 ? `${count} of the three panelists chose this word` : undefined}>
            {word}{count > 1 ? <em class="aol-rb__agree">×{count}</em> : null}
          </span>
        ))}
      </span>
    </span>

    {/* Three ticks, one per panelist's total. A wide spread is the most
        interesting thing a row can carry, and here it is drawn rather than
        averaged into silence. */}
    {takeTotals.length === 3 ? (
      <span class="aol-rb__spread" data-split={isSplit || undefined}
        title={isSplit
          ? `The panel disagreed by ${entry.split_spread} points`
          : "The three panelists' individual totals"}>
        {takeTotals.map((t) => (
          <i style={`left:${Math.round((t / 30) * 100)}%`} />
        ))}
        <span class="aol-sr-only">
          {isSplit
            ? `Panel split — ${entry.split_spread} points between highest and lowest`
            : "Panel in agreement"}
        </span>
      </span>
    ) : (
      <span class="aol-rb__spread" aria-hidden="true"></span>
    )}

    <span class:list={["aol-rb__band", band.solid && "aol-rb__band--solid"]}>
      <PixelIcon name={band.icon as any} size={24} />
      <span class="aol-sr-only">{band.label}</span>
    </span>

    <span class="aol-rb__score">{fmt(entry.total)}<em class="aol-rb__out">/30</em></span>
  </a>
</li>
