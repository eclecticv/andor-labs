---
// One leaderboard row. Extracted so the flat preview on the landing page, the
// divisional tables on the leaderboard, and the rows hidden behind "show the
// rest" are all literally the same markup — three near-copies of a row is how
// a board starts drifting between the places it appears.
import PixelIcon from "./PixelIcon.astro";
import { scoreBand, categoryLabel, keywordsFor, type Entry } from "../../lib/rankings";

interface Props {
  entry: Entry;
  rank: number;
  /** Division leader — takes the crown. */
  leader?: boolean;
  /** Best score on the whole board — takes the trophy instead. */
  champion?: boolean;
}
const { entry, rank, leader = false, champion = false } = Astro.props;
const band = scoreBand(entry.total);
const keywords = keywordsFor(entry);
---

<li class="aol-rb__row">
  <a class="aol-rb__link" href={`/tools/rank-my-adtech/${entry.slug}/`}>
    <span class="aol-rb__rank">{rank}</span>

    <span class="aol-rb__mark">
      {champion ? (
        <PixelIcon name="trophy-solid" size={24} class="aol-rb__trophy" />
      ) : leader ? (
        <PixelIcon name="crown-solid" size={24} class="aol-rb__crown" />
      ) : null}
    </span>

    {entry.logo_url ? (
      <img class="aol-rb__logo" src={entry.logo_url} alt="" width="28" height="28"
        loading="lazy" decoding="async" />
    ) : (
      <span class="aol-rb__logo aol-rb__logo--blank" aria-hidden="true" />
    )}

    <span class="aol-rb__body">
      <span class="aol-rb__name">
        {entry.name}
        {entry.provisional ? (
          <span class="aol-rb__provisional" title="Too little on the site to judge properly">
            <PixelIcon name="question-circle" size={12} /> provisional
          </span>
        ) : null}
      </span>

      {/* Category and stage, not the one-liner. The one-liner is the company's
          own description of itself and every row of it reads the same; where a
          company sits in the supply chain is the thing you actually scan for. */}
      <span class="aol-rb__keywords">
        <span class="aol-rb__keyword aol-rb__keyword--cat">{categoryLabel(entry.category)}</span>
        {keywords.map((k) => <span class="aol-rb__keyword">{k}</span>)}
      </span>
    </span>

    <span class:list={["aol-rb__band", band.solid && "aol-rb__band--solid"]} title={band.label}>
      <PixelIcon name={band.icon as any} size={24} />
    </span>

    <span class="aol-rb__score">{entry.total}</span>
  </a>
</li>
