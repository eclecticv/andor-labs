  name:
    | "pencil-ruler" | "analytics" | "newspaper" | "trending" | "robot"
    | "seedlings" | "refresh" | "users-crown" | "handshake" | "bolt"
    | "reddit" | "anthropic" | "open-ai"
    | "flag-checkered" | "play-solid";
  size?: number;
  class?: string;
  [key: string]: any;
}
const { name, size = 24, class: className, ...rest } = Astro.props;

