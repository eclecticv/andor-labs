---
import Button from "../ds/Button.astro";
import Badge from "../ds/Badge.astro";
import { BOOKING_URL, PROMISE } from "../../config";

const PRESS = ["Digiday", "Forbes", "Adweek", "eMarketer"];

// ANDOR/OS boot log — server-rendered in its FINAL state (no-JS and
// reduced-motion visitors see the completed check); JS replays it as a slow
// boot on load. Dotted leaders align every status to one column.
//
// No header line: every row sits at the same single indent, so the block reads
// as one column of output rather than a heading with children. INDENT is shared
// by the leader rows, the sign-off and the prompt for exactly that reason —
// change it in one place or they drift apart.
// No leading indent. The log's left edge is set by .aol-term__log's 14px
// padding, which matches .aol-term__head's, so the boot lines start on the same
// vertical as the ANDOR/OS label above them. The old 2-space indent pushed them
// ~16px further right than the header and cost 2 characters of width on every
// line, which mattered once the widest label grew to 23 characters.
const INDENT = "";
// Column width must clear the LONGEST label below — `repeat` throws on a
// negative count, so a label longer than this is a build error, not a wobble.
// 24 is taken from the review's own dot counts: every line there aligned at
// label + dots = 24. Longest label is now 20 chars, so there is 4 to spare.
const LEADER_COL = 24;
const lead = (name: string) => INDENT + name + " " + ".".repeat(LEADER_COL - name.length) + " ";
const BOOT_LINES: { text: string; status?: string; prompt?: boolean }[] = [
  { text: lead("Benchmarking SaaS"), status: "OK" },
  { text: lead("Checking SEO/AEO/CEO"), status: "OK" },
  { text: lead("Grounding the robots"), status: "OK" },
  { text: lead("Turning it off/on"), status: "OK" },
  { text: lead("Buying signals"), status: "RECEIVING" },
  { text: " " },
  { text: INDENT + "all systems ok" },
  { text: INDENT + "> ", prompt: true },
];
---
<section class="aol-hero" style="border-bottom:1px solid var(--ink-200);background:var(--paper)">
  <div class="aol-hero-inner" style="max-width:var(--container-width);width:100%;margin:0 auto">
    <div class="aol-eyebrow aol-hero__eyebrow" data-r style="--r:0">Est. 2025</div>
    <h1 class="aol-hero__headline" data-r style="font-family:var(--font-display);font-weight:400;font-size:42px;line-height:1.18;letter-spacing:0;max-width:30.5rem;--r:1">Full-stack GTM for visionary builders &amp; operators</h1>
    <div class="aol-hero__term" data-r style="--r:4">
      <div class="aol-term">
        <div class="aol-term__head" aria-hidden="true">
          <span>ANDOR/OS v1.0</span>
          <span class="aol-term__head-right">CRT-01 <span class="aol-term__led"></span></span>
        </div>
        <div class="aol-term__screen">
          <div class="aol-term__log" aria-hidden="true">
            {BOOT_LINES.map((l) => (
              <div class={"aol-term__line" + (l.prompt ? " aol-term__prompt" : "")}>{l.text}{l.status && <span class={"aol-term__ok" + (l.status !== "OK" ? " aol-term__ok--live" : "")}>{l.status}</span>}</div>
            ))}
          </div>
          <!-- NVIDIA Inception, stamped bottom-right ON the screen rather than
               added to the credibility strip — a third cell there forced the
               strip taller and made the logo reel outgrow its old size. Absolute
               so the screen keeps its exact dimensions. Partner lockup: never
               recolored or reproportioned. -->
          <a class="aol-term__stamp" href="https://www.nvidia.com/en-us/startups/" target="_blank" rel="noopener" aria-label="NVIDIA Inception program member">
            <!-- alt="" because the anchor's aria-label already names it — with
                 both, the label wins and the alt is dead weight. Intrinsic
                 dimensions match the rendered 34px height at the artwork's true
                 2.3168 ratio, so it reserves its box and can't shift layout.
                 NOT lazy: this is above the fold, and deferring it would flash
                 an empty corner on the hero. -->
            <img src="/partners/nvidia-inception.svg" alt="" width="79" height="34" decoding="async" />
          </a>
        </div>
      </div>
    </div>
    <p class="aol-hero__subhead" data-r style="font-size:21px;line-height:1.5;color:var(--ink-600);max-width:42ch;--r:2">
      {PROMISE}
    </p>
    {/* PARKED — credibility line, hidden for now.
        Sits between the promise and the CTA: last thing read before the ask,
        which is where proof does the most work. DOM order matches the
        grid-area order in site.css, so a screen reader gets the same reading
        order as the screen — restore both together if this stays put.
        A JSX comment, not an HTML one, so it's stripped at build rather than
        shipped as readable source. The Badge import and the `founder` grid
        area are deliberately left in place so uncommenting is the only step. */}
    {/* <p class="aol-hero__founder" data-r style="font-family:var(--font-mono);font-size:13px;line-height:1.5;letter-spacing:0.02em;color:var(--ink-600);--r:3">Founded by former Head of Marketing at<br /><strong style="font-weight:400;color:var(--ink-900)">Blockthrough</strong> &amp; <strong style="font-weight:400;color:var(--ink-900)">AdPushup</strong> <Badge variant="tint" class="aol-founderpill">Sold for &gt;$100M</Badge></p> */}
    <div class="aol-hero__cta" data-r style="--r:4"><Button size="lg" variant="primary" arrow href={BOOKING_URL} target="_blank" rel="noopener">Book a call</Button></div>
  </div>
  <div class="aol-grid-blue" data-r style="border-top:1px solid var(--ink-200);--r:5">
    <div style="max-width:var(--container-width);width:100%;margin:0 auto;padding:var(--space-6) var(--gutter)">
    <div class="aol-credstrip" style="border-top:0;padding-top:0">
      <div class="aol-credstrip__cell">
        <span class="aol-eyebrow">As seen on</span>
        <span class="aol-credstrip__val">{PRESS.join("  ·  ")}</span>
      </div>
      <div class="aol-credstrip__cell">
        <span class="aol-eyebrow">Brand partners</span>
        <span class="aol-credstrip__val">AirOps  ·  Superdesign  ·  Snitcher</span>
      </div>
    </div>
    </div>
  </div>
</section>

<script>
  // ── ANDOR/OS boot — the log is server-rendered in its final state; with JS +
  // motion allowed we hide it and replay a slow, deliberate boot (line lands,
  // beat, status lands). Final state = the completed check resting on a prompt.
  // Never blocks page load — it's the hero figure's own behavior, not a gate.
  const term = document.querySelector<HTMLElement>(".aol-term");
  const lines = term ? Array.from(term.querySelectorAll<HTMLElement>(".aol-term__line")) : [];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let timers: number[] = [];
  const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

  const runBoot = () => {
    if (!term) return;
    clearTimers();
    term.classList.remove("is-booted");
    term.classList.add("is-on", "is-booting");
    lines.forEach((l) => {
      l.classList.remove("is-in");
      l.querySelector(".aol-term__ok")?.classList.remove("is-in");
    });
    // Deliberate cadence: each check prints and its status lands a beat
    // later — the old-POST rhythm, unhurried.
    let t = 500;
    lines.forEach((l) => {
      const ok = l.querySelector<HTMLElement>(".aol-term__ok");
      const isBlank = l.textContent!.trim() === "";
      timers.push(window.setTimeout(() => l.classList.add("is-in"), t));
      if (ok) {
        timers.push(window.setTimeout(() => ok.classList.add("is-in"), t + 340));
        t += 780;
      } else {
        t += isBlank ? 220 : 620;
      }
    });
    timers.push(window.setTimeout(() => {
      term.classList.remove("is-booting");
      term.classList.add("is-booted");
    }, t + 300));
  };

  if (term) {
    if (reduce) {
      term.classList.add("is-on", "is-booted");
    } else {
      window.setTimeout(runBoot, 450);
    }
  }
</script>
