---
// "What we do" — the capability ledger, ported from the design system's
// `explorations/capabilities/ledger-a2-warm-bands.html` (dsCard: "What we do —
// A2 Warm bands"). Alternating warm/white bands inside one hard-ruled block,
// serif titles, copper numerals on the warm rows and blue on the white ones.
//
// Sits between the founder note and the offers: the note frames the problem and
// the offers ask for money, so this is where a buyer asks "what do you actually
// do?" The block's 1.5px ink rules top and bottom are what separate it from the
// paper section above, which is why it can share that surface without the two
// reading as one undifferentiated stretch of white.
//
// Content is the full six capabilities (the DS exploration showed only four;
// 04 Research/IP and 05 Generative media were missing there and match the
// vault's "Areas of expertise"). The em dash in 06 is a comma here, per the
// standing no-em-dash rule for site copy. Kickers for 04 and 05 are written to
// match the register of the four the design supplied.
import PixelIcon from "../ds/PixelIcon.astro";

// Icons come from the HackerNoon Pixel Icon Library (24px grid, the same pixel
// logic as Departure Mono, which is why they read as type rather than clip-art).
// They take the left rail in place of the numerals. All blue, deliberately: the
// brand reserves copper for partner and status marks, so a single signal colour
// across the whole ledger is the more correct reading of the system.
const capabilities: { icon: "pencil-ruler" | "analytics" | "newspaper" | "trending" | "robot"; title: string; kicker: string; body: string }[] = [
  {
    icon: "pencil-ruler",
    title: "Positioning &amp; web&nbsp;design",
    kicker: "pitch + site",
    body: "Bulletproof your pitch by auditing it against peer-reviewed findings on brand, messaging, design, pricing, etc., then pair it with a site built on modern frameworks.",
  },
  {
    icon: "analytics",
    title: "Tech stack &amp; analytics",
    kicker: "audit",
    body: "Get the insights you need to make better GTM decisions by reviewing your tech stack, tag setup, and analytics pipes to understand gaps and areas of improvement.",
  },
  {
    icon: "newspaper",
    title: "Research, data &amp; IP creation",
    kicker: "reports + IP",
    body: "Establish your topical authority with custom industry reports, white papers, and thematic content series that earn press coverage, buyer attention, and sales pipeline.",
  },
  {
    icon: "trending",
    title: "Search, AI &amp; social growth",
    kicker: "share of voice",
    body: "Track and improve your share of voice in search, AI citations, and social channels by producing high-quality content rooted in a deep understanding of your ICP.",
  },
  {
    icon: "robot",
    title: "AI × GTM transformation",
    kicker: "systems · agents",
    body: "Build repeatable systems for every aspect of your GTM process including brand, creative, growth, analytics, operations, etc., with custom skills, plugins, and AI agents.",
  },
];
---
<!-- Grid. This section is what re-starts the page's grid<->white alternation:
     the founder note above is paper, so this has to be grid, and everything
     downstream flips to keep the rhythm (Offers paper, Compare grid, FAQ paper).
     Sitting this on paper was what broke it, since it made three white sections
     in a row from the hero down. -->
<section id="what-we-do" class="aol-grid-blue" style="border-bottom:1px solid var(--ink-200)">
  <div style="max-width:var(--container-width);margin:0 auto;padding:var(--section-pad-y) var(--gutter)">
    <div class="aol-eyebrow" style="margin-bottom:14px">what we do</div>
    <h2 class="aol-display" style="font-size:40px;margin:0 0 36px">(Stakeholder management not included.)</h2>

    <div class="aol-ledger">
      {capabilities.map((c) => (
        <div class="aol-ledger__band">
          <span class="aol-ledger__icon"><PixelIcon name={c.icon} size={30} /></span>
          <div class="aol-ledger__head">
            <h3 class="aol-ledger__title" set:html={c.title} />
            <span class="aol-ledger__kicker">{c.kicker}</span>
          </div>
          <p class="aol-ledger__body">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
