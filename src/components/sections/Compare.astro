---
// This section is now just the comparison table. The quote reel lives under the
// founder note (it corroborates his claim, not the table), and the trailing CTA
// was cut — so there's no Button or BOOKING_URL to import.
import ComparisonTable from "../ds/ComparisonTable.astro";

const columns = [
  { name: "And/or Labs", note: "", featured: true },
  { name: "Full-service agency", note: "" },
  { name: "Specialist consultant", note: "" },
];
const rows = [
  {
    label: `<strong>Go-to-market scope</strong>`,
    cells: [{ mark: "yes", text: "Full-stack" }, { mark: "partial", text: "Broad but generic" }, { mark: "no", text: "Messaging/comms" }],
  },
  {
    label: `<strong>B2B operator experience</strong>`,
    cells: [{ mark: "yes", text: "2x Exited" }, { mark: "no", text: "Generalist" }, { mark: "partial", text: "Tangential" }],
  },
  {
    label: `<strong>Builds &amp; ships the work</strong>`,
    cells: [{ mark: "yes", text: "Yes" }, { mark: "yes", text: "Yes" }, { mark: "no", text: "Limited" }],
  },
  {
    label: `<strong>Speed to value</strong>`,
    cells: [{ mark: "yes", text: "Weeks" }, { mark: "no", text: "Months" }, { mark: "partial", text: "Varies" }],
  },
  {
    // Was "$$ / $$$$ / $$$", which asked the reader to re-derive a comparison
    // one section after the offers state exact figures. Our own number is quoted
    // straight from those cards. The other two columns describe the pricing
    // MODEL rather than inventing a figure: agency and consultant rates are not
    // ours to publish, and a made-up number would be worse than the dollar signs.
    // The real contrast is published-vs-on-request, which is also just true.
    label: `<strong>Pricing</strong>`,
    cells: [
      // Kept short on purpose: cells get ~92px of text width once the mark and
      // padding are subtracted from the table's 640px min-width, so anything
      // longer wraps to three lines and this row towers over the others.
      // "Published" is redundant anyway, since ours is the only column here
      // carrying an actual number.
      { mark: "yes", text: "From $1,000/mo" },
      { mark: "no", text: "Quote on request" },
      { mark: "partial", text: "Day or project rate" },
    ],
  },
];
---
<!-- Paper: see the note in Offers.astro — the two swapped surfaces along with
     their positions, so the page keeps alternating grid <-> white. -->
<section id="compare" style="border-bottom:1px solid var(--ink-200);background:var(--paper)">
  <div style="max-width:var(--container-width);margin:0 auto;padding:var(--section-pad-y) var(--gutter)">
    <div class="aol-eyebrow" style="margin-bottom:14px">the alternatives</div>
    <h2 class="aol-display" style="font-size:40px;margin:0 0 40px">Full-stack growth partner</h2>
    <div class="aol-cmp-frame">
      <ComparisonTable columns={columns} rows={rows} />
    </div>
  </div>
</section>
