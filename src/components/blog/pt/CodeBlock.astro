---
/**
 * Fenced code. Deliberately unhighlighted.
 *
 * Syntax highlighting here would mean shipping a highlighter (Shiki adds a
 * grammar bundle per language) to colour the handful of snippets this blog
 * actually contains, and the house palette is one signal colour on paper —
 * a rainbow token theme would be the loudest thing on any page it appeared on.
 * Monospace on near-black, with the language named in the bar, is enough.
 */
import type { Props as $ } from "astro-portabletext/types";

interface CodeBlockNode {
  _type: "codeBlock";
  language?: string;
  filename?: string;
  code?: string;
}
export type Props = $<CodeBlockNode & { _type: string }>;

const { node } = Astro.props;
const { language = "text", filename, code } = node as unknown as CodeBlockNode;
---
{code && (
  <figure class="aol-code aol-break">
    <div class="aol-code__bar">
      <span class="aol-code__lang">{language}</span>
      {filename && <span class="aol-code__file">{filename}</span>}
    </div>
    {/* set:html is not used — code must render as literal text, and Astro
        escapes expression content, which is exactly what we want here. */}
    <pre><code>{code}</code></pre>
  </figure>
)}
