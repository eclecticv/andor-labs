---
/**
 * Sticky contents rail, ≥1280px only.
 *
 * Rendered from the same `extractHeadings` output that stamped the ids onto
 * the headings themselves, so the links cannot point at anchors that don't
 * exist. Hidden entirely below three or so headings — a two-item contents
 * list for a short post is furniture, not navigation.
 */
import type { Heading } from "../../lib/portableText";

interface Props {
  headings: Heading[];
  minimum?: number;
}
const { headings, minimum = 3 } = Astro.props;
const show = headings.length >= minimum;
---
{show && (
  <nav class="aol-toc" aria-label="On this page" data-toc>
    <p class="aol-toc__label">Contents</p>
    <ol>
      {headings.map((h) => (
        <li class={`lvl-${h.level}`}>
          <a href={`#${h.id}`} data-toc-link={h.id}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  // Highlight the section currently being read.
  //
  // rootMargin's -55% bottom inset means a heading counts as "current" once it
  // reaches the upper third of the viewport, rather than the instant it
  // crosses the very top — which would flicker between two entries while a
  // heading sits on the boundary during a slow scroll.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((a) => {
      links.set(a.dataset.tocLink!, a);
    });

    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (targets.length) {
      let current = "";
      const setCurrent = (id: string) => {
        if (id === current) return;
        if (current) links.get(current)?.removeAttribute("aria-current");
        current = id;
        links.get(id)?.setAttribute("aria-current", "true");
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]?.target.id) setCurrent(visible[0].target.id);
        },
        { rootMargin: "-88px 0px -55% 0px", threshold: 0 },
      );
      targets.forEach((t) => observer.observe(t));
    }
  }
</script>
