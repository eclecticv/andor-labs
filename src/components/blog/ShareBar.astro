---
/**
 * Share controls. Plain links plus one clipboard button — no third-party
 * widgets, which is both a performance decision and a privacy one: the
 * official X and LinkedIn buttons load tracking scripts that fire on page
 * view, before anyone has chosen to share anything.
 *
 * `orientation="vertical"` is the sticky-rail variant used at ≥1340px.
 */
interface Props {
  url: string;
  title: string;
  orientation?: "horizontal" | "vertical";
  label?: boolean;
}
const { url, title, orientation = "horizontal", label = true } = Astro.props;

const enc = encodeURIComponent;
const x = `https://x.com/intent/post?text=${enc(title)}&url=${enc(url)}`;
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`;
const email = `mailto:?subject=${enc(title)}&body=${enc(`${title}\n\n${url}`)}`;
---
<div class="aol-share" data-share data-url={url} data-orientation={orientation}>
  {label && <span class="aol-share__label">Share</span>}

  <a class="aol-share__btn" href={x} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </a>

  <a class="aol-share__btn" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
  </a>

  <a class="aol-share__btn" href={email} aria-label="Share by email">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
  </a>

  <button type="button" class="aol-share__btn" data-copy aria-label="Copy link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7L12 19"/></svg>
  </button>

  <span class="aol-share__toast" role="status" aria-live="polite"></span>
</div>

<style>
  .aol-share__toast {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--blue-600);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .aol-share__toast[data-on] { opacity: 1; }
</style>

<script>
  // Delegated so both the inline bar and the sticky rail are handled by one
  // listener, and so it survives either of them being absent at a breakpoint.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>("[data-copy]");
    if (!btn) return;
    const bar = btn.closest<HTMLElement>("[data-share]");
    const url = bar?.dataset.url;
    if (!url) return;

    const toast = bar?.querySelector<HTMLElement>(".aol-share__toast");
    const done = (msg: string) => {
      btn.dataset.copied = "true";
      if (toast) {
        toast.textContent = msg;
        toast.setAttribute("data-on", "");
      }
      window.setTimeout(() => {
        delete btn.dataset.copied;
        toast?.removeAttribute("data-on");
      }, 1800);
    };

    try {
      await navigator.clipboard.writeText(url);
      done("Copied");
    } catch {
      // Clipboard API is unavailable over plain HTTP and in some embedded
      // webviews. Say so rather than appearing to do nothing.
      done("Press ⌘C");
    }
  });
</script>
