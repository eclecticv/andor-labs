---
import "../styles/main.css";
import AgentationDevTool from "../components/Agentation.tsx";
import CopyDiffer from "../components/CopyDiffer.astro";
import { PROMISE } from "../config";

// Meta copy mirrors the hero: the title/description a buyer sees in search is
// the same promise as the one above the fold. The title had drifted back to the
// retired "GTM OS" line while the hero and footer moved on, so it is spelled out
// here to match the H1 verbatim. Pipe separator, not an em dash, by request.
const SITE_TITLE = "And/or Labs | Full-stack GTM for visionary builders & operators";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  ogImage?: string; // site-relative path OR absolute URL; defaults to the site card
  ogImageAlt?: string;
  /** Per-page opt-out. Only honoured when true, so the default stays indexable. */
  noIndex?: boolean;
}
const {
  title = SITE_TITLE,
  description = PROMISE,
  ogType = "website",
  publishedTime,
  ogImage: ogImagePath = "/og.png",
  ogImageAlt = SITE_TITLE,
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(ogImagePath, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {/* Google Tag Manager — prod-only so dev + Agentation traffic stays out of analytics */}
    {import.meta.env.PROD && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-MFGN59WT');`} />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Emitted only when opting out. An unconditional `robots` tag with
        "index, follow" is inert — it just restates the default — and it is one
        typo away from deindexing the site. */}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="And/or Labs | Writing" href="/blog/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:site_name" content="And/or Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@eclecticV" />
    <meta name="twitter:creator" content="@eclecticV" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
    />
    <link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {/* Google Tag Manager (noscript) — prod-only, immediately after <body> per GTM spec */}
    {import.meta.env.PROD && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MFGN59WT" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <slot />

    {/* Dev-only visual feedback — annotate the live page, agent reads it via MCP on :4747 */}
    {import.meta.env.DEV && <AgentationDevTool client:only="react" />}

    {/* Dev-only inline copy editor — edit text in place, copy a diff to hand back */}
    {import.meta.env.DEV && <CopyDiffer />}
  </body>
</html>
